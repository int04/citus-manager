@baseUrl = http://localhost:5115
@clusterId = 00000000-0000-0000-0000-000000000000
@operationId = 00000000-0000-0000-0000-000000000000

# Login through /Account/Login first; requests use the Identity cookie from the client session.

### OpenAPI (development, anonymous)
GET {{baseUrl}}/openapi/v1.json

### List cluster profiles (never returns passwords/tokens)
GET {{baseUrl}}/api/clusters

### Register coordinator after read-only capability scan
POST {{baseUrl}}/api/clusters
Content-Type: application/json

{
  "name": "Production Citus",
  "host": "coordinator.internal",
  "port": 5432,
  "database": "appdb",
  "username": "citus_monitor",
  "password": "replace-in-client-only",
  "sslMode": "VerifyFull",
  "prometheusBaseUrl": "https://prometheus.internal",
  "prometheusBearerToken": null
}

### Test coordinator connection from the MVC form
# Requires authenticated Identity cookie and a current anti-forgery token from /Clusters/Create.
POST {{baseUrl}}/Clusters/TestConnection
Content-Type: application/x-www-form-urlencoded
X-Requested-With: XMLHttpRequest

__RequestVerificationToken=replace-from-form&Host=coordinator.internal&Port=5432&Database=appdb&Username=citus_monitor&Password=replace-in-client-only&SslMode=VerifyFull

### Refresh inventory
POST {{baseUrl}}/api/clusters/{{clusterId}}/refresh

### Open database explorer (authenticated browser route)
GET {{baseUrl}}/Clusters/{{clusterId}}/Database

### Lazy-load one database tree group (columns, keys, foreign-keys, indexes, checks, partitions)
GET {{baseUrl}}/Clusters/{{clusterId}}/Database/Tree/Children?schema=public&name=events&group=columns

### Browse one table (requires Identity cookie + anti-forgery token from explorer page)
POST {{baseUrl}}/Clusters/{{clusterId}}/Database/Browse
Content-Type: application/x-www-form-urlencoded

__RequestVerificationToken=replace-from-form&Schema=public&Table=events&Page=1&PageSize=50

### Execute unrestricted coordinator SQL (requires Identity cookie + anti-forgery token)
POST {{baseUrl}}/Clusters/{{clusterId}}/Database/ExecuteSql
Content-Type: application/x-www-form-urlencoded

__RequestVerificationToken=replace-from-form&Confirmed=true&Sql=SELECT%20version()%3B

### Read sanitized activity (no SQL text/parameters)
GET {{baseUrl}}/api/clusters/{{clusterId}}/activity

### Read metric samples
GET {{baseUrl}}/api/clusters/{{clusterId}}/metrics?take=1000

### Create and automatically queue a rebalance plan
POST {{baseUrl}}/api/operations/clusters/{{clusterId}}
Content-Type: application/json

{
  "kind": "Rebalance",
  "workerHost": null,
  "workerPort": null,
  "externalCapacityAndBackupChecksAcknowledged": true,
  "typedConfirmation": null
}

### Create drain plan
POST {{baseUrl}}/api/operations/clusters/{{clusterId}}
Content-Type: application/json

{
  "kind": "DrainWorker",
  "workerHost": "worker-03.internal",
  "workerPort": 5432,
  "externalCapacityAndBackupChecksAcknowledged": true,
  "typedConfirmation": null
}

### Create remove plan; host confirmation must match exactly and placements must already be zero
POST {{baseUrl}}/api/operations/clusters/{{clusterId}}
Content-Type: application/json

{
  "kind": "RemoveWorker",
  "workerHost": "worker-03.internal",
  "workerPort": 5432,
  "externalCapacityAndBackupChecksAcknowledged": true,
  "typedConfirmation": "worker-03.internal"
}

### Create durable local-to-distributed table conversion plan
POST {{baseUrl}}/api/operations/clusters/{{clusterId}}/table-conversions
Content-Type: application/json

{
  "schema": "public",
  "table": "events",
  "targetMode": "Distributed",
  "distributionColumn": "tenant_id",
  "colocateWith": null,
  "shardCount": 64,
  "externalCapacityAndBackupChecksAcknowledged": true,
  "typedConfirmation": "public.events"
}

### Refresh database tree partial
GET {{baseUrl}}/Clusters/{{clusterId}}/Database/Tree

### Read database action metadata and Citus capabilities
GET {{baseUrl}}/Clusters/{{clusterId}}/Database/ActionMetadata

### Queue a legacy operation that still has AwaitingApproval status
POST {{baseUrl}}/api/operations/{{operationId}}/approve

### Request safe cancel/stop
POST {{baseUrl}}/api/operations/{{operationId}}/cancel

### Read alerts
GET {{baseUrl}}/api/alerts?state=Open

### Read sanitized audit (Admin)
GET {{baseUrl}}/api/audit?take=100

### Delete local profile only; target Citus database is untouched
DELETE {{baseUrl}}/api/clusters/{{clusterId}}
