@model SqlExecutionResponse
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DatabaseResource> T
<div class="notice success pma-query-message" role="status">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
    <span><strong>@T["Sql.Success"]</strong> @T["Sql.SuccessDetail", Model.Duration.TotalMilliseconds.ToString("N0"), Model.RecordsAffected, string.Join(", ", Model.CommandTags), Model.QueryHash.Substring(0, 12)]</span>
</div>
@if (Model.ResultSetLimitReached) { <div class="warning-callout">@T["Sql.ResultLimit"]</div> }
@if (Model.ResultSets.Count == 0) { <div class="empty-state compact">@T["Sql.NoResult"]</div> }
@for (var resultIndex = 0; resultIndex < Model.ResultSets.Count; resultIndex++)
{
    var result = Model.ResultSets[resultIndex];
    <section class="pma-result-set">
        <div class="database-result-meta pma-result-toolbar"><span><strong>@T["Sql.Result", resultIndex + 1, result.Rows.Count]</strong></span>@if (result.IsTruncated) { <span class="status-pill warning">@T["Sql.Truncated"]</span> }</div>
        <div class="table-wrap database-data-table pma-browse-table"><table><thead><tr>@foreach (var column in result.Columns) { <th><span>@column.Name</span><small>@column.DataType</small></th> }</tr></thead><tbody>
        @foreach (var row in result.Rows) { <tr>@foreach (var cell in row) { <td>@if (cell.IsNull) { <span class="database-null">NULL</span> } else { <span class="database-cell">@cell.Value</span>@if (cell.IsTruncated) { <small class="database-truncated">@T["Grid.Truncated"]</small> } }</td> }</tr> }
        </tbody></table></div>
    </section>
}
