@model TableDataResponse
<div class="pma-query-message" role="status">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
    <span>Đang hiển thị <strong>@Model.Rows.Count</strong> hàng ở trang <strong>@Model.Page</strong>. Truy vấn mất @Model.Duration.TotalMilliseconds.ToString("N0") ms.</span>
</div>
<div class="database-result-meta pma-result-toolbar">
    <span>Kết quả truy vấn</span>
    @if (!Model.HasStableOrder) { <span class="status-pill warning">Thứ tự không ổn định · thiếu primary key</span> }
</div>
@if (Model.Columns.Count == 0)
{
    <div class="empty-state compact"><h3>Không có result columns</h3></div>
}
else
{
    <div class="table-wrap database-data-table pma-browse-table"><table><thead><tr>
        @foreach (var column in Model.Columns) { <th><span>@column.Name</span><small>@column.DataType</small></th> }
    </tr></thead><tbody>
        @if (Model.Rows.Count == 0) { <tr><td colspan="@Model.Columns.Count" class="!py-12 !text-center">Bảng chưa có dữ liệu trong phạm vi target này.</td></tr> }
        @foreach (var row in Model.Rows)
        {
            <tr>@foreach (var cell in row)
            {
                <td title="@(cell.IsTruncated ? "Giá trị đã bị cắt theo giới hạn hiển thị" : null)">
                    @if (cell.IsNull) { <span class="database-null">NULL</span> }
                    else { <span class="database-cell">@cell.Value</span>@if (cell.IsTruncated) { <small class="database-truncated">… truncated</small> } }
                </td>
            }</tr>
        }
    </tbody></table></div>
}
<div class="database-pager pma-pagination" aria-label="Phân trang dữ liệu">
    <button type="button" class="btn btn-secondary" data-database-page="@(Model.Page - 1)" disabled="@(!Model.HasPrevious)">
        <span aria-hidden="true">‹</span> Trang trước
    </button>
    <span>Trang <strong>@Model.Page</strong></span>
    <button type="button" class="btn btn-secondary" data-database-page="@(Model.Page + 1)" disabled="@(!Model.HasNext)">
        Trang sau <span aria-hidden="true">›</span>
    </button>
</div>
