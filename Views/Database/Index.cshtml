@model DatabaseExplorerPageViewModel
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DatabaseResource> T
@{
    ViewData["Title"] = T["Page.Title", Model.Cluster.Name];
}

@section Styles {
    <link rel="stylesheet" href="~/css/query-console.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/database-designer.css" asp-append-version="true" />
}

<div class="database-page pma-explorer" data-database-explorer
     data-cluster-id="@Model.Cluster.Id"
     data-workspace-user="@User.Identity?.Name"
     data-browse-url="@Url.Action("Browse", "Database", new { clusterId = Model.Cluster.Id })"
     data-structure-url="@Url.Action("Structure", "Database", new { clusterId = Model.Cluster.Id })"
     data-sql-url="@Url.Action("ExecuteSql", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-metadata-url="@Url.Action("ConsoleMetadata", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-analyze-url="@Url.Action("AnalyzeConsoleSql", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-execute-url="@Url.Action("ExecuteConsoleSql", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-skip-url="@Url.Action("SkipConsoleStatement", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-result-query-url="@Url.Action("QueryConsoleResult", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-result-count-url="@Url.Action("CountConsoleResult", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-result-cell-url="@Url.Action("ReadConsoleResultCell", "Database", new { clusterId = Model.Cluster.Id })"
     data-console-result-export-url="@Url.Action("ExportConsoleResult", "Database", new { clusterId = Model.Cluster.Id })"
     data-tree-url="@Url.Action("Tree", "Database", new { clusterId = Model.Cluster.Id })"
     data-tree-children-url="@Url.Action("TreeChildren", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-metadata-url="@Url.Action("WorkspaceMetadata", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-query-url="@Url.Action("QueryRows", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-inspect-url="@Url.Action("InspectRow", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-locations-url="@Url.Action("LocateRows", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-count-url="@Url.Action("CountRows", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-cell-url="@Url.Action("ReadCell", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-apply-url="@Url.Action("ApplyRows", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-ddl-url="@Url.Action("ObjectDdl", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-csv-preview-url="@Url.Action("PreviewCsv", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-csv-import-url="@Url.Action("ImportCsv", "Database", new { clusterId = Model.Cluster.Id })"
     data-workspace-csv-export-url="@Url.Action("ExportCsv", "Database", new { clusterId = Model.Cluster.Id })"
     data-metadata-url="@Url.Action("ActionMetadata", "Database", new { clusterId = Model.Cluster.Id })"
     data-view-definition-url="@Url.Action("ViewDefinition", "Database", new { clusterId = Model.Cluster.Id })"
     data-table-definition-url="@Url.Action("TableDesignerDefinition", "Database", new { clusterId = Model.Cluster.Id })"
     data-sequence-inspect-url="@Url.Action("InspectSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-dependencies-url="@Url.Action("Dependencies", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-schema-url="@Url.Action("CreateSchema", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-table-url="@Url.Action("CreateTable", "Database", new { clusterId = Model.Cluster.Id })"
     data-modify-table-url="@Url.Action("ModifyTable", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-view-url="@Url.Action("CreateView", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-sequence-url="@Url.Action("CreateSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-rename-url="@Url.Action("Rename", "Database", new { clusterId = Model.Cluster.Id })"
     data-drop-url="@Url.Action("Drop", "Database", new { clusterId = Model.Cluster.Id })"
     data-truncate-url="@Url.Action("Truncate", "Database", new { clusterId = Model.Cluster.Id })"
     data-restart-sequence-url="@Url.Action("RestartSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-refresh-materialized-view-url="@Url.Action("RefreshMaterializedView", "Database", new { clusterId = Model.Cluster.Id })"
     data-convert-table-url="@Url.Action("PlanTableConversion", "Database", new { clusterId = Model.Cluster.Id })"
     data-table-information-url="@Url.Action("TableInformation", "Database", new { clusterId = Model.Cluster.Id })"
     data-table-information-exact-url="@Url.Action("InspectTableExact", "Database", new { clusterId = Model.Cluster.Id })"
     data-range-preflight-url="@Url.Action("PreflightRangePartitions", "Database", new { clusterId = Model.Cluster.Id })"
     data-range-operation-url="@Url.Action("CreateRangePartitionsOperation", "Database", new { clusterId = Model.Cluster.Id })"
     data-merge-operation-url="@Url.Action("CreateMergePartitionsOperation", "Database", new { clusterId = Model.Cluster.Id })"
     data-reindex-operation-url="@Url.Action("CreateRebuildIndexOperation", "Database", new { clusterId = Model.Cluster.Id })"
     data-table-mode-operation-url="@Url.Action("CreateTableModeOperation", "Database", new { clusterId = Model.Cluster.Id })"
     data-operation-progress-template="@Url.Action("DatabaseOperationProgress", "Database", new { clusterId = Model.Cluster.Id, operationId = Guid.Empty })"
     data-operation-cancel-template="@Url.Action("CancelDatabaseOperation", "Database", new { clusterId = Model.Cluster.Id, operationId = Guid.Empty })"
     data-show-system="@Model.ShowSystem.ToString().ToLowerInvariant()"
     data-node-id="@Model.NodeId">
    <form id="database-antiforgery" class="hidden">@Html.AntiForgeryToken()</form>

    <button class="pma-navigation-toggle" id="database-navigation-toggle" type="button"
            aria-controls="database-navigation" aria-expanded="false" aria-label="@T["Navigation.Open"]">
        <i class="fa fa-database" aria-hidden="true"></i><span>@T["Navigation.Objects"]</span>
    </button>
    <div class="database-workbench pma-workbench">
        <button class="pma-navigation-scrim hidden" id="database-navigation-scrim" type="button" aria-label="@T["Navigation.Close"]"></button>
        <aside class="database-tree pma-navigation" id="database-navigation" aria-label="@T["Navigation.Tree"]">
            <div class="pma-navigation-toolbar">
                <a class="pma-home-button" asp-controller="Clusters" asp-action="Details" asp-route-id="@Model.Cluster.Id" aria-label="@T["Navigation.BackCluster"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6"/></svg>
                </a>
                <span class="pma-navigation-title">@T["Navigation.Tree"]</span>
                <span class="status-pill neutral">@Model.Objects.Count</span>
                <button class="pma-navigation-close" id="database-navigation-close" type="button" aria-label="@T["Navigation.Close"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <label class="database-search pma-filter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                <span class="sr-only">@T["Navigation.Filter"]</span>
                <input id="database-object-search" type="search" placeholder="@T["Navigation.FilterPlaceholder"]" autocomplete="off" />
            </label>

            <div id="database-tree-content"><partial name="_Tree" model="Model" /></div>
            <nav class="pma-navigation-footer" aria-label="@T["Navigation.Tools"]">
                <a asp-controller="Settings" asp-action="Language" aria-label="@T["Navigation.Appearance"]">
                    <i class="fa fa-language" aria-hidden="true"></i><span>@T["Navigation.Appearance"]</span>
                </a>
                <a asp-controller="Clusters" asp-action="Details" asp-route-id="@Model.Cluster.Id" aria-label="@T["Navigation.BackCluster"] @Model.Cluster.Name">
                    <i class="fa fa-chevron-left" aria-hidden="true"></i><span>@T["Navigation.BackCluster"]</span>
                </a>
                <a asp-controller="Database" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id"
                   asp-route-nodeId="@Model.NodeId" asp-route-showSystem="@(!Model.ShowSystem)"
                   aria-label="@(Model.ShowSystem ? T["Navigation.HideSystem"] : T["Navigation.ShowSystem"])">
                    <i class="fa @(Model.ShowSystem ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                    <span>@(Model.ShowSystem ? T["Navigation.HideSystem"] : T["Navigation.ShowSystem"])</span>
                </a>
                <div class="pma-navigation-server" title="@Model.Cluster.Host:@Model.Cluster.Port · @Model.Cluster.Database · @Model.TargetLabel">
                    <i class="fa fa-server" aria-hidden="true"></i>
                    <span>Server</span><b class="status-dot ok" aria-hidden="true"></b>
                </div>
            </nav>
        </aside>

        <div id="database-navigation-splitter" class="pma-navigation-splitter" role="separator"
             aria-label="@T["Navigation.Resize"]" aria-orientation="vertical" tabindex="0"></div>

        <section class="database-content pma-content database-workspace-host" aria-live="polite">
            <nav id="database-workspace-tabs" class="database-workspace-tabs" role="tablist" aria-label="@T["Workspace.Label"]"></nav>
            <div id="database-feedback" class="connection-result error hidden" role="alert" tabindex="-1"></div>
            <div id="database-workspace-stage" class="database-workspace-stage">
                <div id="database-workspace-empty" class="empty-state pma-welcome-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 9v11"/></svg>
                    <h3>@T["Workspace.EmptyTitle"]</h3>
                    <p>@T["Workspace.EmptyDescription"]</p>
                </div>
                <div id="database-workspace-content" class="database-workspace-content hidden"></div>
            </div>
        </section>
    </div>

    <footer id="database-workspace-status" class="database-workspace-status" aria-live="polite">
        <div class="database-workspace-path"><span>Database</span><b>›</b><span>@Model.TargetLabel</span><b>›</b><strong>@Model.Cluster.Database</strong></div>
        <div id="database-workspace-statistics" class="database-workspace-statistics">@T["Workspace.EmptyStats"]</div>
    </footer>

    @if (Model.IsCoordinator && Model.CanOperate)
    {
        <div id="sql-confirm-modal" class="database-modal hidden" role="dialog" aria-modal="true" aria-labelledby="sql-confirm-title">
            <div class="database-modal-card">
                <div class="pma-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg>
                </div>
                <p class="eyebrow">UNRESTRICTED SQL</p>
                <h2 id="sql-confirm-title">@T["Sql.ConfirmTitle"]</h2>
                <p class="pma-modal-copy">@T["Sql.ConfirmDescription", Model.Cluster.Name, Model.Cluster.Database]</p>
                <div class="form-actions"><button type="button" class="btn btn-ghost" id="close-sql-modal">@T["Action.Cancel"]</button><button type="button" class="btn btn-danger" id="confirm-sql-button">@T["Sql.RunConfirmed"]</button></div>
            </div>
        </div>
    }

    <div id="database-context-menu" class="database-context-menu hidden" role="menu" aria-label="Database object actions"></div>
    <div id="database-action-modal" class="database-modal hidden" role="dialog" aria-modal="true"
         aria-labelledby="database-action-title" aria-describedby="database-action-description">
        <div class="database-modal-card database-action-card" tabindex="-1">
            <div class="database-action-heading">
                <div class="database-action-title-lockup">
                    <span class="database-action-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg></span>
                    <div><p class="eyebrow" id="database-action-eyebrow">DATABASE ACTION</p><h2 id="database-action-title">@T["Action.Title"]</h2></div>
                </div>
                <button type="button" class="database-action-close" aria-label="@T["Action.Close"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <p id="database-action-description" class="pma-modal-copy"></p>
            <form id="database-action-form" novalidate>
                <div id="database-action-fields" class="database-action-fields"></div>
                <div id="database-action-error" class="connection-result error hidden" role="alert" tabindex="-1"></div>
                <div class="form-actions database-action-footer">
                    <button type="button" class="btn btn-ghost database-action-cancel">@T["Action.Cancel"]</button>
                    <button type="submit" class="btn btn-primary" id="database-action-submit">@T["Action.Confirm"]</button>
                </div>
            </form>
        </div>
    </div>
    <aside id="database-operation-drawer" class="database-operation-drawer hidden" aria-label="Database operations">
        <header><div><i class="fa fa-tasks" aria-hidden="true"></i><strong>Operations</strong></div><button id="database-operation-close" type="button" aria-label="@T["Action.Close"]"><i class="fa fa-times" aria-hidden="true"></i></button></header>
        <div id="database-operation-list" class="database-operation-list" aria-live="polite"></div>
    </aside>
    <div id="database-toast" class="database-toast hidden" role="status" aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/js/vendor/query-console-editor.js" asp-append-version="true"></script>
    <script type="module" src="~/js/database-workspaces.js" asp-append-version="true"></script>
    <script src="~/js/database-explorer-actions.js" asp-append-version="true"></script>
}
