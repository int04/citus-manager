@model DatabaseExplorerPageViewModel
@{
    ViewData["Title"] = $"Database · {Model.Cluster.Name}";
}

<div class="database-page pma-explorer" data-database-explorer
     data-browse-url="@Url.Action("Browse", "Database", new { clusterId = Model.Cluster.Id })"
     data-structure-url="@Url.Action("Structure", "Database", new { clusterId = Model.Cluster.Id })"
     data-sql-url="@Url.Action("ExecuteSql", "Database", new { clusterId = Model.Cluster.Id })"
     data-tree-url="@Url.Action("Tree", "Database", new { clusterId = Model.Cluster.Id })"
     data-metadata-url="@Url.Action("ActionMetadata", "Database", new { clusterId = Model.Cluster.Id })"
     data-view-definition-url="@Url.Action("ViewDefinition", "Database", new { clusterId = Model.Cluster.Id })"
     data-sequence-inspect-url="@Url.Action("InspectSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-dependencies-url="@Url.Action("Dependencies", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-schema-url="@Url.Action("CreateSchema", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-table-url="@Url.Action("CreateTable", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-view-url="@Url.Action("CreateView", "Database", new { clusterId = Model.Cluster.Id })"
     data-create-sequence-url="@Url.Action("CreateSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-rename-url="@Url.Action("Rename", "Database", new { clusterId = Model.Cluster.Id })"
     data-drop-url="@Url.Action("Drop", "Database", new { clusterId = Model.Cluster.Id })"
     data-truncate-url="@Url.Action("Truncate", "Database", new { clusterId = Model.Cluster.Id })"
     data-restart-sequence-url="@Url.Action("RestartSequence", "Database", new { clusterId = Model.Cluster.Id })"
     data-refresh-materialized-view-url="@Url.Action("RefreshMaterializedView", "Database", new { clusterId = Model.Cluster.Id })"
     data-convert-table-url="@Url.Action("PlanTableConversion", "Database", new { clusterId = Model.Cluster.Id })"
     data-show-system="@Model.ShowSystem.ToString().ToLowerInvariant()"
     data-node-id="@Model.NodeId">
    <form id="database-antiforgery" class="hidden">@Html.AntiForgeryToken()</form>

    <header class="pma-topbar">
        <div class="pma-product-mark" aria-label="Citus Manager Database Explorer">
            <span class="pma-product-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg>
            </span>
            <span><strong>Citus Manager</strong><small>Database Explorer</small></span>
        </div>

        <div class="pma-server-summary">
            <span class="pma-target-chip @(Model.IsCoordinator ? "coordinator" : "worker")">
                <span class="status-dot ok" aria-hidden="true"></span>
                @(Model.IsCoordinator ? "Coordinator · toàn cluster" : "Worker · shard cục bộ")
            </span>
            <div class="pma-server-path" aria-label="Vị trí hiện tại">
                <span class="pma-path-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="3" width="16" height="7" rx="2"/><rect x="4" y="14" width="16" height="7" rx="2"/><path d="M8 6.5h.01M8 17.5h.01"/></svg>
                    Server: <strong>@Model.Cluster.Host:@Model.Cluster.Port</strong>
                </span>
                <span class="pma-path-separator" aria-hidden="true">›</span>
                <span class="pma-path-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg>
                    Database: <strong>@Model.Cluster.Database</strong>
                </span>
                @if (!Model.IsCoordinator)
                {
                    <span class="pma-path-separator" aria-hidden="true">›</span>
                    <span class="pma-path-item">Node: <strong>@Model.TargetLabel</strong></span>
                }
            </div>
        </div>

        <div class="pma-top-actions">
            <button class="pma-icon-action pma-navigation-toggle" id="database-navigation-toggle" type="button"
                    aria-controls="database-navigation" aria-expanded="false" aria-label="Mở cây điều hướng database">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span>Đối tượng</span>
            </button>
            <button class="pma-icon-action" id="theme-toggle" type="button" aria-label="Đổi giao diện sáng tối">
                <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
                <span>Giao diện</span>
            </button>
            <a class="pma-icon-action" asp-controller="Clusters" asp-action="Details" asp-route-id="@Model.Cluster.Id">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                <span>Cluster</span>
            </a>
            <a class="pma-icon-action" asp-controller="Database" asp-action="Index"
               asp-route-clusterId="@Model.Cluster.Id" asp-route-nodeId="@Model.NodeId"
               asp-route-showSystem="@(!Model.ShowSystem)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                <span>@(Model.ShowSystem ? "Ẩn system" : "Hiện system")</span>
            </a>
        </div>
    </header>

    <div class="database-workbench pma-workbench">
        <button class="pma-navigation-scrim hidden" id="database-navigation-scrim" type="button" aria-label="Đóng cây điều hướng database"></button>
        <aside class="database-tree pma-navigation" id="database-navigation" aria-label="Cây đối tượng database">
            <div class="pma-navigation-toolbar">
                <a class="pma-home-button" asp-controller="Clusters" asp-action="Details" asp-route-id="@Model.Cluster.Id" aria-label="Về trang cluster">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6"/></svg>
                </a>
                <span class="pma-navigation-title">Cây điều hướng</span>
                <span class="status-pill neutral">@Model.Objects.Count</span>
                <button class="pma-navigation-close" id="database-navigation-close" type="button" aria-label="Đóng cây điều hướng database">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <label class="database-search pma-filter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                <span class="sr-only">Lọc database object</span>
                <input id="database-object-search" type="search" placeholder="Lọc theo tên…" autocomplete="off" />
            </label>

            <div id="database-tree-content"><partial name="_Tree" model="Model" /></div>
        </aside>

        <section class="database-content pma-content" aria-live="polite">
            <div class="pma-context-bar">
                <div class="pma-context-primary">
                    <nav class="database-tabs pma-main-tabs" aria-label="Chức năng database" role="tablist">
                        <button type="button" class="is-active" data-database-tab="data" role="tab" aria-selected="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg>
                            Duyệt
                        </button>
                        <button type="button" data-database-tab="structure" role="tab" aria-selected="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
                            Cấu trúc
                        </button>
                        @if (Model.IsCoordinator && Model.CanOperate)
                        {
                            <button type="button" data-database-tab="sql" role="tab" aria-selected="false">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"/></svg>
                                SQL
                            </button>
                        }
                    </nav>
                </div>
                <label class="pma-page-size" for="database-page-size">
                    <span>Số hàng:</span>
                    <select id="database-page-size">
                        @foreach (var size in Model.AllowedPageSizes) { <option value="@size" selected="@(size == 50)">@size</option> }
                    </select>
                </label>
            </div>

            <div id="database-feedback" class="connection-result error hidden" role="alert" tabindex="-1"></div>
            <div id="database-result" class="database-result pma-result-area">
                <div class="empty-state pma-welcome-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg>
                    <h3>Chọn một đối tượng từ cây điều hướng</h3>
                    <p>Mở schema bên trái, sau đó chọn bảng, view hoặc sequence để duyệt dữ liệu và cấu trúc.</p>
                </div>
            </div>

            @if (Model.IsCoordinator && Model.CanOperate)
            {
                <section id="sql-console" class="sql-console pma-sql-console hidden" aria-labelledby="sql-console-title">
                    <div class="pma-section-title">
                        <div><h2 id="sql-console-title">Chạy truy vấn SQL trên database <strong>@Model.Cluster.Database</strong></h2><p>Nhập một hoặc nhiều câu lệnh SQL.</p></div>
                    </div>
                    <div class="warning-callout"><strong>Quyền lực đầy đủ:</strong> SQL chạy trực tiếp trên coordinator bằng credential đã lưu. DML, DDL và multi-statement đều được phép.</div>
                    <label class="pma-editor-label" for="sql-editor">Câu lệnh SQL</label>
                    <textarea id="sql-editor" spellcheck="false" placeholder="SELECT * FROM public.my_table LIMIT 100;"></textarea>
                    <div class="sql-actions">
                        <span>Timeout @Model.CommandTimeoutSeconds s · tối đa @Model.MaxRowsPerResultSet.ToString("N0") hàng/result set</span>
                        <div>
                            <button type="button" class="btn btn-ghost hidden" id="cancel-sql-button">Dừng query</button>
                            <button type="button" class="btn btn-primary" id="prepare-sql-button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 5 8 7-8 7V5Z"/></svg>
                                Thực thi
                            </button>
                        </div>
                    </div>
                    <div id="sql-result" class="pma-sql-result"></div>
                </section>
            }
        </section>
    </div>

    @if (Model.IsCoordinator && Model.CanOperate)
    {
        <div id="sql-confirm-modal" class="database-modal hidden" role="dialog" aria-modal="true" aria-labelledby="sql-confirm-title">
            <div class="database-modal-card">
                <div class="pma-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg>
                </div>
                <p class="eyebrow">UNRESTRICTED SQL</p>
                <h2 id="sql-confirm-title">Xác nhận thực thi</h2>
                <p class="pma-modal-copy">Target: <strong>@Model.Cluster.Name / @Model.Cluster.Database</strong>. Câu lệnh có thể thay đổi hoặc xóa dữ liệu.</p>
                <div class="form-actions"><button type="button" class="btn btn-ghost" id="close-sql-modal">Hủy</button><button type="button" class="btn btn-danger" id="confirm-sql-button">Tôi hiểu, chạy SQL</button></div>
            </div>
        </div>
    }

    <div id="database-context-menu" class="database-context-menu hidden" role="menu" aria-label="Database object actions"></div>
    <div id="database-action-modal" class="database-modal hidden" role="dialog" aria-modal="true"
         aria-labelledby="database-action-title" aria-describedby="database-action-description">
        <div class="database-modal-card database-action-card" tabindex="-1">
            <div class="database-action-heading">
                <div class="database-action-title-lockup">
                    <span class="database-action-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg></span>
                    <div><p class="eyebrow" id="database-action-eyebrow">DATABASE ACTION</p><h2 id="database-action-title">Thao tác database</h2></div>
                </div>
                <button type="button" class="database-action-close" aria-label="Đóng dialog">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <p id="database-action-description" class="pma-modal-copy"></p>
            <form id="database-action-form" novalidate>
                <div id="database-action-fields" class="database-action-fields"></div>
                <div id="database-action-error" class="connection-result error hidden" role="alert" tabindex="-1"></div>
                <div class="form-actions database-action-footer">
                    <button type="button" class="btn btn-ghost database-action-cancel">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="database-action-submit">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
    <div id="database-toast" class="database-toast hidden" role="status" aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/js/database-explorer-actions.js" asp-append-version="true"></script>
}
