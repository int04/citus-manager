@model IReadOnlyList<UserListItemViewModel>
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UsersResource> T
@{ ViewData["Title"] = T["Title"]; }
<div class="page-heading"><div><p class="eyebrow">RBAC</p><h1>@T["Title"]</h1><p>@T["Description"]</p></div><a class="btn btn-primary" asp-action="Create">@T["Add"]</a></div>
<div class="table-wrap"><table><thead><tr><th>@T["User"]</th><th>Email</th><th>@T["Roles"]</th><th>@T["State"]</th></tr></thead><tbody>
@foreach (var user in Model)
{ <tr><td>@user.DisplayName</td><td>@user.Email</td><td>@foreach (var role in user.Roles) { <span class="status-pill neutral me-1">@role</span> }</td><td>@(user.Locked ? T["Locked"] : T["Active"])</td></tr> }
</tbody></table></div>
