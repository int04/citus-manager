@model CreateUserViewModel
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UsersResource> T
@inject IStringLocalizer<SharedResource> S
@{ ViewData["Title"] = T["Add"]; }
<div class="page-heading narrow-heading"><div><p class="eyebrow">RBAC</p><h1>@T["Add"]</h1><p>@T["CreateDescription"]</p></div></div>
<form asp-action="Create" method="post" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="form-grid">
        <div class="field"><label asp-for="DisplayName">@T["DisplayName"]</label><input asp-for="DisplayName" autocomplete="name" /><span asp-validation-for="DisplayName"></span></div>
        <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
        <div class="field"><label asp-for="Password">@T["TemporaryPassword"]</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
        <div class="field"><label asp-for="Role">@T["PrimaryRole"]</label><select asp-for="Role"><option>Viewer</option><option>Operator</option><option>Admin</option></select><span asp-validation-for="Role"></span></div>
    </div>
    <div class="form-actions"><a class="btn btn-ghost" asp-action="Index">@S["Common.Cancel"]</a><button class="btn btn-primary" type="submit">@T["Create"]</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
