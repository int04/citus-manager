@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@{ ViewData["Title"] = T["Privacy.Title"]; }
<div class="page-heading"><div><p class="eyebrow">SECURITY</p><h1>@T["Privacy.Title"]</h1><p>@T["Privacy.Description"]</p></div></div>
<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <section class="panel"><h2>Credentials</h2><p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@T["Privacy.Credentials"]</p></section>
    <section class="panel"><h2>Activity</h2><p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@T["Privacy.Activity"]</p></section>
    <section class="panel"><h2>Audit</h2><p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@T["Privacy.Audit"]</p></section>
</div>
