@model DashboardViewModel
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ClusterResource> T
@{
    ViewData["Title"] = T["Home.Title"];
    var activeOps = Model.Operations.Count(x => x.Status is OperationStatus.Approved or OperationStatus.Running or OperationStatus.Cancelling);
    var failedOps = Model.Operations.Count(x => x.Status is OperationStatus.Failed or OperationStatus.RecoveryRequired);
}
<div class="page-heading">
    <div><p class="eyebrow">CONTROL PLANE</p><h1>@T["Home.Title"]</h1><p>@T["Home.Description"]</p></div>
    @if (User.IsInRole("Operator") || User.IsInRole("Admin"))
    { <a class="btn btn-primary" asp-controller="Clusters" asp-action="Create">@T["Create.Title"]</a> }
</div>
<section class="metric-grid" aria-label="@T["Home.Summary"]">
    <article class="metric-card"><span>@T["Home.Clusters"]</span><strong>@Model.Clusters.Count</strong><small>@T["Home.Profiles"]</small></article>
    <article class="metric-card"><span>@T["Home.Healthy"]</span><strong>@Model.Clusters.Count(x => x.LastError is null)</strong><small>@T["Home.LastCheck"]</small></article>
    <article class="metric-card"><span>@T["Home.ActiveOps"]</span><strong>@activeOps</strong><small>approved / running</small></article>
    <article class="metric-card @(failedOps > 0 ? "metric-danger" : "")"><span>@T["Home.Attention"]</span><strong>@failedOps</strong><small>failed / recovery</small></article>
</section>
<section class="section-block">
    <div class="section-title"><div><h2>@T["Home.Clusters"]</h2><p>@T["Home.ClusterDescription"]</p></div></div>
    @if (Model.Clusters.Count == 0)
    {
        <div class="empty-state"><h3>@T["Home.EmptyTitle"]</h3><p>@T["Home.EmptyDescription"]</p>
        @if (User.IsInRole("Operator") || User.IsInRole("Admin")) { <a class="btn btn-primary" asp-controller="Clusters" asp-action="Create">@T["Home.FirstCluster"]</a> }
        </div>
    }
    else
    {
        <div class="cluster-grid">
        @foreach (var cluster in Model.Clusters)
        {
            <a class="cluster-card" asp-controller="Clusters" asp-action="Details" asp-route-id="@cluster.Id">
                <div class="cluster-card-head"><span class="status-dot @(cluster.LastError is null ? "ok" : "bad")" aria-hidden="true"></span><strong>@cluster.Name</strong><span class="status-pill @(cluster.LastError is null ? "success" : "danger")">@(cluster.LastError is null ? "READY" : "CHECK")</span></div>
                <code>@cluster.Host:@cluster.Port/@cluster.Database</code>
                <dl class="compact-dl"><div><dt>Citus</dt><dd>@(cluster.CitusVersion ?? T["Home.Unknown"])</dd></div><div><dt>SSL</dt><dd>@cluster.SslMode</dd></div><div><dt>@T["Home.Checked"]</dt><dd>@(cluster.LastCheckedAt?.ToLocalTime().ToString("g") ?? T["Home.Never"])</dd></div></dl>
            </a>
        }
        </div>
    }
</section>
<section class="section-block">
    <div class="section-title"><div><h2>@T["Home.RecentOps"]</h2><p>Plan → queue → runner → validation.</p></div></div>
    <partial name="~/Views/Clusters/_OperationTable.cshtml" model="Model.Operations.Take(10).ToList()" />
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/clusters.css" asp-append-version="true" />
}
