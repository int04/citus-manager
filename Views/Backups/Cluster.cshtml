@model BackupClusterViewModel
@using System.Text.Json
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BackupResource> T
@{
    ViewData["Title"] = T["Page.Title", Model.Page.Cluster.Name];
    var backupPage = Model.Page;
    var policy = backupPage.Policy;
    var canOperate = User.IsInRole("Operator") || User.IsInRole("Admin");
    var isAdmin = User.IsInRole("Admin");
    var successfulRuns = backupPage.BackupRuns.Count(x => (x.Status is "Succeeded" or "PartialSucceeded") && x.Destinations.Any(y => y.Status == "Succeeded"));
    var activeRuns = backupPage.BackupRuns.Count(x => x.Status is "Queued" or "Running" or "RetryScheduled" or "Cancelling");
}

@section Styles { <link rel="stylesheet" href="~/css/backups.css" asp-append-version="true" /> }

<div class="page-heading backup-heading">
    <div>
        <a class="backup-back" asp-controller="Clusters" asp-action="Details" asp-route-id="@backupPage.Cluster.Id"><i class="fa fa-arrow-left" aria-hidden="true"></i> @T["Page.ClusterDetails"]</a>
        <p class="eyebrow">@T["Page.Eyebrow"]</p>
        <h1>@backupPage.Cluster.Name</h1>
        <p><code>@backupPage.Cluster.Host:@backupPage.Cluster.Port/@backupPage.Cluster.Database</code> · @T["Page.Description"]</p>
    </div>
    @if (canOperate)
    {
        <div class="heading-actions">
            <button class="btn btn-primary" type="button" id="backup-now" data-url="/api/clusters/@backupPage.Cluster.Id/backup-runs">
                <i class="fa fa-play" aria-hidden="true"></i><span>@T["Action.BackupNow"]</span>
            </button>
        </div>
    }
</div>

<form id="backup-antiforgery" class="hidden">@Html.AntiForgeryToken()</form>
<div id="backup-feedback" class="hidden notice" role="alert" tabindex="-1"></div>
<div id="backup-live-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

<section class="metric-grid" aria-label="@T["Overview.Label"]">
    <article class="metric-card"><span>@T["Overview.Schedule"]</span><strong class="backup-metric-text">@(policy.Enabled ? T["Common.Enabled"] : T["Common.Disabled"])</strong><small>@(policy.NextRunAt?.ToString("u") ?? T["Overview.NoNextRun"])</small></article>
    <article class="metric-card"><span>@T["Overview.Available"]</span><strong>@successfulRuns</strong><small>@T["Overview.AvailableHelp"]</small></article>
    <article class="metric-card"><span>@T["Overview.Active"]</span><strong>@activeRuns</strong><small>@T["Overview.ActiveHelp"]</small></article>
    <article class="metric-card"><span>@T["Overview.Retention"]</span><strong class="backup-metric-text">@T["Overview.RetentionDays", policy.RetentionDays]</strong><small>@T["Overview.RetentionHelp", policy.RetentionMinimum, policy.RetentionMaximum]</small></article>
</section>

<section class="section-block">
    <div class="section-title">
        <div><h2>@T["Policy.Title"]</h2><p>@T["Policy.Help"]</p></div>
    </div>
    <form id="backup-policy" class="panel backup-policy" data-url="/api/clusters/@backupPage.Cluster.Id/backup-policy">
        <fieldset @(canOperate ? null : "disabled")>
            <legend class="sr-only">@T["Policy.Legend"]</legend>
            <div class="backup-policy-top">
                <label class="check-field backup-enabled"><input name="enabled" type="checkbox" checked="@policy.Enabled" /><span><strong>@T["Policy.Automatic"]</strong><small>@T["Policy.AutomaticHelp"]</small></span></label>
                <div class="field"><label for="templateId">@T["Policy.Template"]</label><select id="templateId" name="templateId"><option value="">@T["Policy.Custom"]</option>@foreach (var template in backupPage.Templates) { <option value="@template.Id" selected="@(template.Id == policy.TemplateId)">@template.Name · v@template.Version</option> }</select></div>
            </div>

            <div class="backup-form-grid">
                <div class="field"><label for="interval">@T["Schedule.Every"]</label><input id="interval" name="interval" type="number" min="1" max="999" value="@policy.Interval" required /></div>
                <div class="field"><label for="unit">@T["Schedule.Period"]</label><select id="unit" name="unit">@foreach (var unit in Enum.GetValues<CitusManager.Contracts.BackupScheduleUnit>()) { <option value="@unit" selected="@(unit == policy.Unit)">@T[$"Schedule.Unit.{unit}"]</option> }</select></div>
                <div class="field" data-schedule-field="minute"><label for="minute">@T["Schedule.Minute"]</label><input id="minute" name="minute" type="number" min="0" max="59" value="@policy.Minute" required /></div>
                <div class="field" data-schedule-field="hour"><label for="hour">@T["Schedule.Hour"]</label><input id="hour" name="hour" type="number" min="0" max="23" value="@policy.Hour" required /></div>
                <div class="field" data-schedule-field="week"><label for="dayOfWeek">@T["Schedule.DayOfWeek"]</label><select id="dayOfWeek" name="dayOfWeek">@for (var day = 0; day < 7; day++) { <option value="@day" selected="@(policy.DayOfWeek == day)">@T[$"Day.{(DayOfWeek)day}"]</option> }</select></div>
                <div class="field" data-schedule-field="month"><label for="dayOfMonth">@T["Schedule.DayOfMonth"]</label><input id="dayOfMonth" name="dayOfMonth" type="number" min="1" max="31" value="@(policy.DayOfMonth ?? 1)" /><small>@T["Schedule.MissingDate"]</small></div>
                <div class="field"><label for="timeZone">@T["Schedule.TimeZone"]</label><input id="timeZone" name="timeZone" value="@policy.TimeZone" maxlength="100" required autocomplete="off" /></div>
                <div class="field"><label for="retryCount">@T["Schedule.Retries"]</label><input id="retryCount" name="retryCount" type="number" min="0" max="20" value="@policy.RetryCount" required /></div>
            </div>

            <details class="backup-advanced">
                <summary>@T["Policy.RetentionEncryption"]</summary>
                <div class="backup-form-grid">
                    <div class="field"><label for="retentionDays">@T["Policy.MaximumAge"]</label><input id="retentionDays" name="retentionDays" type="number" min="1" max="36500" value="@policy.RetentionDays" required /></div>
                    <div class="field"><label for="retentionMinimum">@T["Policy.MinimumValid"]</label><input id="retentionMinimum" name="retentionMinimum" type="number" min="1" max="1000" value="@policy.RetentionMinimum" required /></div>
                    <div class="field"><label for="retentionMaximum">@T["Policy.MaximumValid"]</label><input id="retentionMaximum" name="retentionMaximum" type="number" min="1" max="1000" value="@policy.RetentionMaximum" required /></div>
                    <label class="check-field"><input name="encryptionEnabled" type="checkbox" checked="@policy.EncryptionEnabled" /><span><strong>@T["Policy.Encryption"]</strong><small>@T["Policy.EncryptionWarning"]</small></span></label>
                </div>
            </details>

            <div class="backup-profile-grid">
                <fieldset class="backup-profile-list"><legend>@T["Profiles.StorageDestinations"]</legend><p>@T["Profiles.StorageHelp"]</p>
                    @if (backupPage.StorageProfiles.Count == 0) { <div class="backup-empty">@T["Profiles.NoStorage"]</div> }
                    @foreach (var profile in backupPage.StorageProfiles)
                    {
                        <label class="profile-option"><input type="checkbox" name="storageProfileIds" value="@profile.Id" checked="@policy.StorageProfileIds.Contains(profile.Id)" /><span><strong>@profile.Name <span class="status-pill @(profile.IsHealthy ? "success" : "danger")">@T[$"StorageType.{profile.Type}"] · @(profile.IsHealthy ? T["Common.Ready"] : T["Common.Unhealthy"])</span></strong><small>@T[$"ProfileSummary.{profile.Type}"]</small></span></label>
                    }
                </fieldset>
                <fieldset class="backup-profile-list"><legend>@T["Profiles.Notifications"]</legend><p>@T["Profiles.NotificationsHelp"]</p>
                    @if (backupPage.NotificationProfiles.Count == 0) { <div class="backup-empty">@T["Profiles.NoNotifications"]</div> }
                    @foreach (var profile in backupPage.NotificationProfiles)
                    {
                        <label class="profile-option"><input type="checkbox" name="notificationProfileIds" value="@profile.Id" checked="@policy.NotificationProfileIds.Contains(profile.Id)" /><span><strong>@profile.Name <span class="status-pill @(profile.IsHealthy ? "success" : "danger")">@T[$"NotificationType.{profile.Type}"] · @(profile.IsHealthy ? T["Common.Ready"] : T["Common.Unhealthy"])</span></strong><small>@T[$"ProfileSummary.{profile.Type}"]</small></span></label>
                    }
                </fieldset>
            </div>
        </fieldset>
        @if (canOperate) { <div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fa fa-save" aria-hidden="true"></i><span>@T["Action.SavePolicy"]</span></button></div> }
    </form>
</section>

@if (canOperate)
{
<section class="section-block">
    <div class="section-title"><div><h2>@T["Profiles.Title"]</h2><p>@T["Profiles.Help"]</p></div></div>
    <div class="backup-profile-editor">
        <details class="panel"><summary>@T["Profiles.AddStorage"]</summary>
            <form data-profile-form data-url="/api/backup-storage-profiles" data-kind="storage" class="backup-editor-form">
                <div class="backup-form-grid">
                    <div class="field"><label>@T["Profiles.Name"]</label><input name="name" maxlength="120" required /></div>
                    <div class="field"><label>@T["Profiles.Type"]</label><select name="type"><option value="Local">@T["StorageType.Local"]</option><option value="S3Compatible">@T["StorageType.S3Compatible"]</option><option value="GoogleDrive">@T["StorageType.GoogleDrive"]</option></select></div>
                    <div class="field"><label>@T["Profiles.LocalSubdirectory"]</label><input name="localSubdirectory" maxlength="500" /></div>
                    <div class="field"><label>@T["Profiles.Endpoint"]</label><input name="endpoint" maxlength="1000" /></div>
                    <div class="field"><label>@T["Profiles.Bucket"]</label><input name="bucket" maxlength="255" /></div>
                    <div class="field"><label>@T["Profiles.Region"]</label><input name="region" maxlength="100" /></div>
                    <div class="field"><label>@T["Profiles.ObjectPrefix"]</label><input name="objectPrefix" maxlength="500" /></div>
                    <div class="field"><label>@T["Profiles.AccessKey"]</label><input name="accessKey" autocomplete="off" /></div>
                    <div class="field"><label>@T["Profiles.SecretKey"]</label><input name="secretKey" type="password" autocomplete="new-password" /></div>
                    <div class="field"><label>@T["Profiles.DriveFolderId"]</label><input name="googleDriveFolderId" /></div>
                    <div class="field"><label>@T["Profiles.GoogleClientId"]</label><input name="googleClientId" autocomplete="off" /></div>
                    <div class="field"><label>@T["Profiles.GoogleClientSecret"]</label><input name="googleClientSecret" type="password" autocomplete="new-password" /></div>
                    <div class="field"><label>@T["Profiles.GoogleRefreshToken"]</label><input name="googleRefreshToken" type="password" autocomplete="new-password" /></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit"><span>@T["Action.CreateStorage"]</span></button></div>
            </form>
        </details>
        <details class="panel"><summary>@T["Profiles.AddNotification"]</summary>
            <form data-profile-form data-url="/api/backup-notification-profiles" data-kind="notification" class="backup-editor-form">
                <div class="backup-form-grid">
                    <div class="field"><label>@T["Profiles.Name"]</label><input name="name" maxlength="120" required /></div>
                    <div class="field"><label>@T["Profiles.Type"]</label><select name="type"><option value="Email">@T["NotificationType.Email"]</option><option value="Telegram">@T["NotificationType.Telegram"]</option></select></div>
                    <div class="field"><label>@T["Profiles.SmtpHost"]</label><input name="smtpHost" maxlength="255" /></div>
                    <div class="field"><label>@T["Profiles.SmtpPort"]</label><input name="smtpPort" type="number" min="1" max="65535" value="587" /></div>
                    <label class="check-field"><input name="smtpUseTls" type="checkbox" checked /><span>@T["Profiles.SmtpTls"]</span></label>
                    <div class="field"><label>@T["Profiles.From"]</label><input name="smtpFrom" maxlength="320" /></div>
                    <div class="field"><label>@T["Profiles.SmtpUsername"]</label><input name="smtpUsername" autocomplete="username" /></div>
                    <div class="field"><label>@T["Profiles.SmtpPassword"]</label><input name="smtpPassword" type="password" autocomplete="new-password" /></div>
                    <div class="field"><label>@T["Profiles.EmailRecipients"]</label><input name="emailRecipients" placeholder="a@example.com, b@example.com" /></div>
                    <div class="field"><label>@T["Profiles.TelegramToken"]</label><input name="telegramBotToken" type="password" autocomplete="new-password" /></div>
                    <div class="field"><label>@T["Profiles.TelegramTargets"]</label><input name="telegramTargets" placeholder="@T["Profiles.TelegramTargetsPlaceholder"]" /></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit"><span>@T["Action.CreateNotification"]</span></button></div>
            </form>
        </details>
    </div>
    <div class="backup-profile-tests">
        @foreach (var profile in backupPage.StorageProfiles) { <button class="btn btn-secondary" type="button" data-profile-test="/api/backup-storage-profiles/@profile.Id/test"><span>@T["Action.TestProfile", profile.Name]</span></button> @if (profile.Type == "GoogleDrive") { <a class="btn btn-secondary" href="/api/backup-storage-profiles/@profile.Id/google/authorize?returnUrl=@Uri.EscapeDataString($"/Backups/Cluster/{backupPage.Cluster.Id}")">@T["Action.AuthorizeProfile", profile.Name]</a> } }
        @foreach (var profile in backupPage.NotificationProfiles) { <button class="btn btn-secondary" type="button" data-profile-test="/api/backup-notification-profiles/@profile.Id/test"><span>@T["Action.TestProfile", profile.Name]</span></button> }
    </div>
</section>
}

<section class="section-block">
    <div class="section-title"><div><h2>@T["Runs.Title"]</h2><p>@T["Runs.Help"]</p></div></div>
    <div class="table-wrap backup-table"><table><thead><tr><th>@T["Runs.Requested"]</th><th>@T["Runs.StatusPhase"]</th><th>@T["Runs.Transferred"]</th><th>@T["Runs.Destinations"]</th><th>@T["Runs.DurationRetry"]</th><th><span class="sr-only">@T["Common.Actions"]</span></th></tr></thead><tbody>
    @if (backupPage.BackupRuns.Count == 0) { <tr><td colspan="6" class="backup-empty-cell">@T["Runs.Empty"]</td></tr> }
    @foreach (var run in backupPage.BackupRuns)
    {
        var active = run.Status is "Queued" or "Running" or "RetryScheduled" or "Cancelling";
        var restorable = (run.Status is "Succeeded" or "PartialSucceeded") && run.Destinations.Any(x => x.Status == "Succeeded");
        <tr data-backup-run="@run.Id" data-progress-url="/api/backup-runs/@run.Id/progress">
            <td><strong>@run.RequestedAt.ToString("g")</strong><small>@T[$"Trigger.{run.Trigger}"] · @T["Runs.Attempt", run.Attempt]</small></td>
            <td><span data-field="status" data-status="@run.Status" class="status-pill @StatusClass(run.Status)">@T[$"Status.{run.Status}"]</span><small data-field="phase" data-phase="@run.Phase">@(run.Phase == "Download/Decrypt" ? T["Phase.DownloadDecrypt"] : T[$"Phase.{run.Phase}"])</small>@if (!string.IsNullOrWhiteSpace(run.SafeError)) { <small class="backup-error" data-field="error">@run.SafeError</small> } else { <small class="backup-error hidden" data-field="error"></small> }</td>
            <td><strong data-field="bytes">@FormatBytes(run.BytesProcessed)</strong><small data-field="estimate">@(run.SourceBytesEstimate is null ? T["Runs.RawUnavailable"] : T["Runs.RawEstimate", FormatBytes(run.SourceBytesEstimate.Value)])</small><small data-field="artifact">@(run.ArtifactBytes is null ? T["Runs.ArchivePending"] : T["Runs.Archive", FormatBytes(run.ArtifactBytes.Value)])</small><small data-field="throughput">@(run.BytesPerSecond is null ? T["Runs.WaitingStream"] : $"{FormatBytes((long)run.BytesPerSecond.Value)}/s")</small><small data-field="objects">@T["Runs.Objects", run.ObjectsCompleted, run.ObjectsTotal is null ? "" : $"/{run.ObjectsTotal}"]</small></td>
            <td><div class="destination-stack" data-field="destinations">@foreach (var destination in run.Destinations) { <span><i class="status-dot @DotClass(destination.Status)"></i>@destination.Name <small>@T[$"Status.{destination.Status}"] · @FormatBytes(destination.BytesUploaded)</small></span> }</div></td>
            <td><span data-field="duration">@Duration(run.StartedAt, run.CompletedAt, T["Common.NotStarted"])</span><small data-field="retry">@(run.RetryAt is null ? "" : T["Runs.Retry", run.RetryAt.Value.ToString("g")])</small></td>
            <td><div class="backup-actions">
                @if (active && canOperate) { <button type="button" class="btn btn-secondary" data-backup-action="cancel" data-url="/api/backup-runs/@run.Id/cancel">@T["Action.Cancel"]</button> }
                @if (restorable && canOperate) { <button type="button" class="btn btn-primary" data-backup-action="restore" data-backup-id="@run.Id">@T["Action.Apply"]</button> }
                @if (isAdmin && restorable) { <button type="button" class="btn btn-ghost" data-backup-action="pin" data-url="/api/backup-runs/@run.Id/pin" data-pinned="@run.IsPinned.ToString().ToLowerInvariant()">@(run.IsPinned ? T["Action.Unpin"] : T["Action.Pin"])</button> }
                @if (isAdmin && !active) { <button type="button" class="btn btn-danger" data-backup-action="delete" data-url="/api/backup-runs/@run.Id">@T["Action.Delete"]</button> }
                <details class="backup-run-details"><summary>@T["Runs.Details"]</summary><ol>@foreach (var step in run.Steps.OrderBy(x => x.Sequence)) { <li><span>@T[$"Phase.{step.Phase}"]</span><small>@T[$"Status.{step.Status}"]@(string.IsNullOrWhiteSpace(step.Detail) ? "" : $" · {step.Detail}")</small></li> }</ol><p>@T["Runs.ApplicationConsistent"] <strong>@(run.ApplicationConsistent ? T["Common.Yes"] : T["Common.No"])</strong> · <a href="/api/backup-runs/@run.Id/manifest" target="_blank" rel="noopener">@T["Runs.Manifest"]</a></p></details>
            </div></td>
        </tr>
    }
    </tbody></table></div>
</section>

<section class="section-block">
    <div class="section-title"><div><h2>@T["Restore.Title"]</h2><p>@T["Restore.Help"]</p></div></div>
    <div class="table-wrap backup-table"><table><thead><tr><th>@T["Runs.Requested"]</th><th>@T["Restore.Target"]</th><th>@T["Runs.StatusPhase"]</th><th>@T["Restore.Processed"]</th><th>@T["Restore.Error"]</th></tr></thead><tbody>
    @if (backupPage.RestoreRuns.Count == 0) { <tr><td colspan="5" class="backup-empty-cell">@T["Restore.Empty"]</td></tr> }
    @foreach (var restore in backupPage.RestoreRuns)
    { <tr data-restore-run="@restore.Id" data-progress-url="/api/restore-runs/@restore.Id/progress"><td>@restore.RequestedAt.ToString("g")</td><td><code>@(restore.TargetClusterId is null ? T["Restore.ExternalTarget"] : restore.TargetDisplay)</code></td><td><span data-field="status" data-status="@restore.Status" class="status-pill @StatusClass(restore.Status)">@T[$"Status.{restore.Status}"]</span><small data-field="phase" data-phase="@restore.Phase">@(restore.Phase == "Download/Decrypt" ? T["Phase.DownloadDecrypt"] : T[$"Phase.{restore.Phase}"])</small></td><td><strong data-field="bytes">@FormatBytes(restore.BytesProcessed)</strong><small data-field="throughput">@(restore.BytesPerSecond is null ? "" : $"{FormatBytes((long)restore.BytesPerSecond.Value)}/s")</small></td><td><span class="backup-error" data-field="error">@restore.SafeError</span></td></tr> }
    </tbody></table></div>
</section>

@if (canOperate)
{
    <dialog id="restore-dialog" class="backup-dialog" aria-labelledby="restore-title">
        <form id="restore-form" method="dialog" data-source-database="@backupPage.Cluster.Database">
            <div class="backup-dialog-head"><div><p class="eyebrow">@T["Restore.Destructive"]</p><h2 id="restore-title">@T["Restore.ApplyTitle"]</h2></div><button type="button" class="btn btn-ghost" data-dialog-close aria-label="@T["Restore.CloseDialog"]"><i class="fa fa-times" aria-hidden="true"></i></button></div>
            <p>@T["Restore.DefaultHelp"]</p>
            <input type="hidden" name="backupRunId" />
            <div class="field"><label for="targetKind">@T["Restore.Target"]</label><select id="targetKind" name="targetKind" required><option value="">@T["Restore.ChooseTarget"]</option>@foreach (var target in backupPage.RestoreTargets.Where(x => isAdmin || x.Id != backupPage.Cluster.Id)) { <option value="@target.Id" data-same-target="@(target.Id == backupPage.Cluster.Id ? "true" : "false")">@target.Name · @target.Host:@target.Port/@target.Database</option> }<option value="external">@T["Restore.OtherConnection"]</option></select></div>
            <div class="backup-external hidden" data-external-target><div class="backup-form-grid"><div class="field"><label for="restoreHost">@T["Restore.Host"]</label><input id="restoreHost" name="host" maxlength="255" /></div><div class="field"><label for="restorePort">@T["Restore.Port"]</label><input id="restorePort" name="port" type="number" min="1" max="65535" value="5432" /></div><div class="field"><label for="restoreDatabase">@T["Restore.Database"]</label><input id="restoreDatabase" name="database" maxlength="63" /></div><div class="field"><label for="restoreUsername">@T["Restore.Username"]</label><input id="restoreUsername" name="username" maxlength="128" autocomplete="username" /></div><div class="field"><label for="restorePassword">@T["Restore.Password"]</label><input id="restorePassword" name="password" type="password" autocomplete="new-password" /></div><div class="field"><label for="restoreSslMode">@T["Restore.SslMode"]</label><select id="restoreSslMode" name="sslMode"><option value="Prefer">@T["Ssl.Prefer"]</option><option value="Require">@T["Ssl.Require"]</option><option value="VerifyCA">@T["Ssl.VerifyCA"]</option><option value="VerifyFull">@T["Ssl.VerifyFull"]</option></select></div></div></div>
            @if (isAdmin)
            {
                <div class="backup-same-target hidden" data-same-target-panel>
                    <div class="warning-callout"><strong>@T["Restore.SameTargetWarning"]</strong> @T["Restore.SameTargetHelp"]</div>
                    <label class="check-field"><input name="maintenanceAcknowledged" type="checkbox" /><span>@T["Restore.MaintenanceAck"]</span></label>
                    <div class="field"><label for="typedConfirmation">@T["Restore.Type"] <code data-confirmation-value>@backupPage.Cluster.Database &lt;backup-id&gt;</code></label><input id="typedConfirmation" name="typedConfirmation" autocomplete="off" /></div>
                </div>
            }
            <div class="form-actions"><button type="button" class="btn btn-secondary" data-dialog-close>@T["Action.Cancel"]</button><button type="submit" class="btn btn-danger"><i class="fa fa-database" aria-hidden="true"></i><span>@T["Action.ValidateApply"]</span></button></div>
        </form>
    </dialog>
}

@section Scripts {
    <script id="backup-i18n-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["requestFailed"] = T["Js.RequestFailed"], ["destination"] = T["Js.Destination"], ["confirmUnencrypted"] = T["Js.ConfirmUnencrypted"],
        ["saving"] = T["Js.Saving"], ["policySaved"] = T["Js.PolicySaved"], ["queueing"] = T["Js.Queueing"], ["testing"] = T["Js.Testing"],
        ["profileTestSucceeded"] = T["Js.ProfileTestSucceeded"], ["confirmCancel"] = T["Js.ConfirmCancel"], ["cancelling"] = T["Js.Cancelling"],
        ["confirmDelete"] = T["Js.ConfirmDelete"], ["deleting"] = T["Js.Deleting"],
        ["confirmMaintenance"] = T["Js.ConfirmMaintenance"], ["typeExactly"] = T["Js.TypeExactly"], ["validating"] = T["Js.Validating"],
        ["rawEstimateUnavailable"] = T["Runs.RawUnavailable"], ["rawEstimate"] = T["Js.RawEstimate"], ["archivePending"] = T["Runs.ArchivePending"],
        ["archive"] = T["Js.Archive"], ["waitingByteStream"] = T["Runs.WaitingStream"], ["objects"] = T["Js.Objects"], ["retry"] = T["Js.Retry"],
        ["processed"] = T["Js.Processed"],
        ["statusQueued"] = T["Status.Queued"], ["statusRunning"] = T["Status.Running"], ["statusRetryScheduled"] = T["Status.RetryScheduled"],
        ["statusSucceeded"] = T["Status.Succeeded"], ["statusPartialSucceeded"] = T["Status.PartialSucceeded"], ["statusFailed"] = T["Status.Failed"],
        ["statusCancelling"] = T["Status.Cancelling"], ["statusCancelled"] = T["Status.Cancelled"], ["statusRecoveryRequired"] = T["Status.RecoveryRequired"],
        ["statusCommitted"] = T["Status.Committed"], ["phasePreflight"] = T["Phase.Preflight"], ["phaseMetadata"] = T["Phase.Metadata"],
        ["phaseDumping"] = T["Phase.Dumping"], ["phaseUploading"] = T["Phase.Uploading"], ["phaseValidating"] = T["Phase.Validating"],
        ["phaseRetention"] = T["Phase.Retention"], ["phaseNotifications"] = T["Phase.Notifications"], ["phaseDownloadDecrypt"] = T["Phase.DownloadDecrypt"],
        ["phasePreData"] = T["Phase.PreData"], ["phaseCitusTopology"] = T["Phase.CitusTopology"], ["phaseData"] = T["Phase.Data"],
        ["phasePostData"] = T["Phase.PostData"], ["phaseValidation"] = T["Phase.Validation"]
    }))</script>
    <script src="~/js/backups.js" asp-append-version="true"></script>
}

@functions {
    static string StatusClass(string status) => status switch { "Succeeded" => "success", "PartialSucceeded" or "RetryScheduled" or "RecoveryRequired" => "warning", "Failed" or "Cancelled" => "danger", _ => "neutral" };
    static string DotClass(string status) => status is "Succeeded" or "Committed" ? "ok" : status is "Failed" ? "bad" : "";
    static string FormatBytes(long bytes) { string[] units = ["B", "KiB", "MiB", "GiB", "TiB"]; double value = Math.Max(0, bytes); var unit = 0; while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; } return $"{value:0.##} {units[unit]}"; }
    static string Duration(DateTimeOffset? start, DateTimeOffset? end, string notStarted) { if (start is null) return notStarted; var duration = (end ?? DateTimeOffset.UtcNow) - start.Value; return duration.TotalHours >= 1 ? $"{duration.TotalHours:0.#}h" : duration.TotalMinutes >= 1 ? $"{duration.TotalMinutes:0.#}m" : $"{duration.TotalSeconds:0}s"; }
}
