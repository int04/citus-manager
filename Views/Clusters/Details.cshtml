@model ClusterDetailsViewModel
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ClusterResource> T
@{
    ViewData["Title"] = Model.Cluster.Name;
    var inventory = Model.Inventory;
    var canOperate = User.IsInRole("Operator") || User.IsInRole("Admin");
    var topologyGroups = ClusterTopologyPresentation.Classify(inventory?.Nodes ?? [], Model.QueryEndpoints);
    var queryNodes = topologyGroups.QueryNodes;
    var workers = topologyGroups.Workers;
}
<link rel="stylesheet" href="~/css/clusters.css" asp-append-version="true" />
<div class="page-heading">
    <div><p class="eyebrow">@Model.Cluster.Host:@Model.Cluster.Port / @Model.Cluster.Database</p><h1>@Model.Cluster.Name</h1><p>Citus @Model.Cluster.CitusVersion · TLS @Model.Cluster.SslMode</p></div>
    <div class="heading-actions"><a class="btn btn-primary" asp-controller="Database" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id">@T["Cluster.Data"]</a><a class="btn btn-secondary" asp-controller="Backups" asp-action="Cluster" asp-route-clusterId="@Model.Cluster.Id"><i class="fa fa-database" aria-hidden="true"></i> @T["Cluster.Backup"]</a>@if (User.IsInRole("Admin") && inventory is not null) { <button class="btn btn-secondary" type="button" data-cluster-header-operation data-open-operation="change-coordinator" data-current-host="@Model.Cluster.Host" data-current-port="@Model.Cluster.Port"><i class="fa fa-exchange" aria-hidden="true"></i> @T["Cluster.ChangeCoordinator"]</button> }<a class="btn btn-secondary" asp-controller="Activity" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id">Activity</a><a class="btn btn-secondary" asp-controller="Metrics" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id">Metrics</a><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Cluster.Id" asp-route-refresh="true">@T["Cluster.Refresh"]</a></div>
</div>
@if (Model.SafeError is not null) { <div class="notice danger" role="alert">@Model.SafeError</div> }
@if (inventory is not null)
{
    <section class="metric-grid" aria-label="@T["Cluster.MetricsLabel"]">
        <article class="metric-card"><span>@T["Cluster.Nodes"]</span><strong>@inventory.Nodes.Count</strong><small>@T["Cluster.Active", inventory.Nodes.Count(x => x.IsActive)]</small></article>
        <article class="metric-card"><span>@T["Cluster.Workers"]</span><strong>@workers.Count</strong><small>@T["Cluster.RegisteredWorkers"]</small></article>
        <article class="metric-card"><span>@T["Cluster.Placements"]</span><strong>@inventory.Nodes.Sum(x => x.PlacementCount)</strong><small>@T["Cluster.ShardCopies"]</small></article>
        <article class="metric-card"><span>@T["Cluster.DistributedTables"]</span><strong>@inventory.Tables.Count</strong><small>@T["Cluster.InventoryAt", inventory.CollectedAt.ToLocalTime().ToString("g")]</small></article>
    </section>

    <section id="cluster-operations"
             class="section-block topology-operations"
             data-cluster-operations
             data-cluster-id="@Model.Cluster.Id"
             data-api-root="/api/operations/clusters/@Model.Cluster.Id"
             data-operation-url="/Operations/Details/{id}"
             data-i18n-moves="@T["Cluster.Moves"]"
             data-i18n-placements-to-move="@T["Cluster.PlacementsToMove"]"
             data-i18n-data-to-move="@T["Cluster.DataToMove"]"
             data-i18n-available-targets="@T["Cluster.AvailableTargets"]"
             data-i18n-source="@T["Cluster.Source"]"
             data-i18n-target="@T["Cluster.Target"]"
             data-i18n-shard="@T["Cluster.Shards"]"
             data-i18n-bytes="@T["Cluster.Bytes"]"
             data-i18n-snapshot="@T["Cluster.Snapshot"]"
              data-i18n-confirmation-mismatch="@T["Cluster.ConfirmationMismatch"]"
              data-i18n-target-confirmation-mismatch="@T["Cluster.TargetEndpointConfirmationMismatch"]"
             data-i18n-recovery-confirmation-mismatch="@T["Cluster.CoordinatorRecoveryConfirmationMismatch"]"
             data-i18n-missing-operation-id="@T["Cluster.MissingOperationId"]"
             data-i18n-preparing-operation="@T["Cluster.PreparingOperation"]"
             data-i18n-active-conflict="@T["Cluster.ActiveConflict"]"
             data-i18n-test-worker-connection="@T["Cluster.TestWorkerConnection"]"
             data-i18n-testing-worker-connection="@T["Cluster.TestingWorkerConnection"]"
             data-i18n-worker-connection-required="@T["Cluster.WorkerConnectionRequired"]"
             data-i18n-worker-connection-changed="@T["Cluster.WorkerConnectionChanged"]"
             data-i18n-worker-connection-succeeded="@T["Cluster.WorkerConnectionSucceeded"]"
             data-i18n-worker-connection-failed="@T["Cluster.WorkerConnectionFailed"]"
             data-i18n-test-coordinator-target="@T["Cluster.TestCoordinatorTarget"]"
             data-i18n-testing-coordinator-target="@T["Cluster.TestingCoordinatorTarget"]"
             data-i18n-coordinator-target-check-required="@T["Cluster.CoordinatorTargetCheckRequired"]"
             data-i18n-coordinator-target-changed="@T["Cluster.CoordinatorTargetChanged"]"
             data-i18n-coordinator-target-ready="@T["Cluster.CoordinatorTargetReady"]"
             data-i18n-coordinator-target-failed="@T["Cluster.CoordinatorTargetFailed"]"
             data-i18n-coordinator-source-registered="@T["Cluster.CoordinatorSourceRegistered"]"
             data-can-operate="@canOperate.ToString().ToLowerInvariant()">
        <div class="section-title topology-title">
            <div><h2>@T["Cluster.Topology"]</h2><p>@T["Cluster.TopologyHelp"]</p></div>
            @if (canOperate)
            {
                <div class="topology-actions" aria-label="@T["Cluster.TopologyActions"]">
                    <button class="btn btn-primary" type="button" data-open-operation="add-worker"><i class="fa fa-plus" aria-hidden="true"></i> @T["Cluster.AddWorker"]</button>
                    <button class="btn btn-secondary" type="button" data-open-operation="add-query"><i class="fa fa-sitemap" aria-hidden="true"></i> @T["Cluster.AddQueryNode"]</button>
                    <button class="btn btn-secondary" type="button" data-open-operation="rebalance"><i class="fa fa-random" aria-hidden="true"></i> @T["Cluster.Rebalance"]</button>
                </div>
            }
        </div>

        <div id="topology-live-status" class="operation-live-strip" aria-live="polite" aria-atomic="true" hidden>
            <div class="operation-live-copy"><span class="status-pill warning" data-live-status>@T["Cluster.OperationRunning"]</span><strong data-live-title></strong><small data-live-detail></small></div>
            <div class="operation-live-progress"><progress max="100" value="0" data-live-progress></progress><span data-live-percent>0%</span></div>
            <a class="table-link" data-live-link href="#">@T["Cluster.ViewOperation"]</a>
        </div>

        <div class="topology-group">
            <div class="topology-group-heading"><div><h3>@T["Cluster.QueryNodes"]</h3><p>@T["Cluster.QueryNodesHelp"]</p></div><span class="status-pill neutral">@queryNodes.Count</span></div>
            @if (queryNodes.Count == 0) { <div class="empty-state compact"><p>@T["Cluster.NoQueryNodes"]</p></div> }
            else
            {
                <div class="topology-grid">
                @foreach (var node in queryNodes)
                {
                    <article class="node-card node-card-query" data-node-card data-node-host="@node.Host" data-node-port="@node.Port">
                        <div class="node-card-head"><span class="status-dot @(node.IsActive ? "ok" : "bad")" aria-hidden="true"></span><div><strong>@node.Host:@node.Port</strong><small>@(node.IsActive ? T["Cluster.ActiveNode"] : T["Cluster.Inactive"])</small></div><span class="node-role">@(node.GroupId == 0 ? T["Cluster.ControlCoordinator"] : T["Cluster.QueryNode"])</span></div>
                        <dl class="compact-dl"><div><dt>@T["Cluster.NodeId"]</dt><dd>@node.NodeId</dd></div><div><dt>@T["Cluster.Group"]</dt><dd>@node.GroupId</dd></div><div><dt>@T["Cluster.Placements"]</dt><dd>@node.PlacementCount</dd></div><div><dt>@T["Cluster.Metadata"]</dt><dd>@(node.MetadataSynced ? T["Cluster.Synced"] : T["Cluster.Unsynced"])</dd></div></dl>
                        <div class="node-card-actions">
                            @if (node.IsActive) { <a class="btn btn-secondary" asp-controller="Database" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id" asp-route-nodeId="@node.NodeId">@T["Cluster.NodeData"]</a> }
                            else { <button class="btn btn-secondary" type="button" disabled title="@T["Cluster.Inactive"]">@T["Cluster.NodeData"]</button> }
                            @if (canOperate && node.GroupId != 0)
                            {
                                <details class="node-action-menu"><summary class="btn btn-ghost" aria-label="@T["Cluster.QueryNodeActions", node.Host]"><i class="fa fa-ellipsis-h" aria-hidden="true"></i><span>@T["Cluster.Actions"]</span></summary><div class="node-action-popover"><button class="danger" type="button" data-open-operation="retire" data-node-kind="query" data-host="@node.Host" data-port="@node.Port"><i class="fa fa-trash-o" aria-hidden="true"></i><span><strong>@T["Cluster.RemoveQueryNode"]</strong><small>@T["Cluster.RemoveQueryNodeShort"]</small></span></button></div></details>
                            }
                        </div>
                    </article>
                }
                </div>
            }
        </div>

        <div class="topology-group">
            <div class="topology-group-heading"><div><h3>@T["Cluster.Workers"]</h3><p>@T["Cluster.WorkersHelp"]</p></div><span class="status-pill neutral">@workers.Count</span></div>
            @if (workers.Count == 0) { <div class="empty-state compact"><p>@T["Cluster.NoWorkers"]</p></div> }
            else
            {
                <div class="topology-grid">
                @foreach (var node in workers)
                {
                    <article class="node-card" data-node-card data-node-host="@node.Host" data-node-port="@node.Port">
                        <div class="node-card-head"><span class="status-dot @(node.IsActive ? "ok" : "bad")" aria-hidden="true"></span><div><strong>@node.Host:@node.Port</strong><small>@(node.IsActive ? T["Cluster.ActiveNode"] : T["Cluster.Inactive"])</small></div><span class="node-role">@(node.ShouldHaveShards ? T["Cluster.Worker"] : T["Cluster.DrainedWorker"])</span></div>
                        <dl class="compact-dl"><div><dt>@T["Cluster.NodeId"]</dt><dd>@node.NodeId</dd></div><div><dt>@T["Cluster.Placements"]</dt><dd>@node.PlacementCount</dd></div><div><dt>@T["Cluster.ShardBytes"]</dt><dd>@FormatBytes(node.ShardBytes)</dd></div><div><dt>@T["Cluster.Group"]</dt><dd>@node.GroupId</dd></div></dl>
                        <div class="node-card-actions">
                            @if (node.IsActive) { <a class="btn btn-secondary" asp-controller="Database" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id" asp-route-nodeId="@node.NodeId">@T["Cluster.NodeData"]</a> }
                            else { <button class="btn btn-secondary" type="button" disabled>@T["Cluster.NodeData"]</button> }
                            @if (canOperate)
                            {
                                <details class="node-action-menu"><summary class="btn btn-ghost" aria-label="@T["Cluster.WorkerActions", node.Host]"><i class="fa fa-ellipsis-h" aria-hidden="true"></i><span>@T["Cluster.Actions"]</span></summary><div class="node-action-popover">@if (node.ShouldHaveShards) { <button type="button" data-open-operation="drain" data-host="@node.Host" data-port="@node.Port"><i class="fa fa-exchange" aria-hidden="true"></i><span><strong>@T["Cluster.DrainWorker"]</strong><small>@T["Cluster.DrainWorkerShort"]</small></span></button> }<button class="danger" type="button" data-open-operation="retire" data-node-kind="worker" data-host="@node.Host" data-port="@node.Port"><i class="fa fa-trash-o" aria-hidden="true"></i><span><strong>@T["Cluster.RetireWorker"]</strong><small>@T["Cluster.RetireWorkerShort"]</small></span></button></div></details>
                            }
                        </div>
                    </article>
                }
                </div>
            }
        </div>

        @if (canOperate)
        {
            <form id="cluster-operation-token" hidden>@Html.AntiForgeryToken()</form>
            <partial name="_TopologyOperationDialogs" model="Model.Cluster" />
        }
    </section>

    <section class="section-block">
        <div class="section-title"><div><h2>@T["Cluster.Tables"]</h2><p>@T["Cluster.TablesHelp"]</p></div></div>
        <div class="table-wrap"><table><thead><tr><th>@T["Cluster.Table"]</th><th>@T["Cluster.Type"]</th><th>@T["Cluster.Distribution"]</th><th>@T["Cluster.Shards"]</th><th>@T["Cluster.Colocation"]</th><th>@T["Cluster.Size"]</th><th>@T["Cluster.Storage"]</th></tr></thead><tbody>
        @foreach (var table in inventory.Tables)
        { <tr><td><code>@table.Name</code></td><td>@table.Type</td><td><code>@table.DistributionColumn</code></td><td>@table.ShardCount</td><td>@table.ColocationId</td><td>@table.TableSize</td><td>@table.AccessMethod</td></tr> }
        </tbody></table></div>
    </section>
}
<section class="section-block">
    <div class="section-title"><div><h2>@T["Cluster.Operations"]</h2><p>@T["Cluster.OperationsHelpNew"]</p></div><a class="btn btn-secondary" asp-controller="Operations" asp-action="Index">@T["Cluster.AllOperations"]</a></div>
    <div id="operation-table-live"><partial name="_OperationTable" model="Model.Operations" /></div>
</section>
@if (User.IsInRole("Admin"))
{
    <section class="danger-zone"><h2>@T["Cluster.Danger"]</h2><p>@T["Cluster.DeleteHelp"]</p><form id="delete-cluster-form" asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Cluster.Id" /><button class="btn btn-danger" type="button" data-open-delete-cluster>@T["Cluster.Delete"]</button></form></section>
    <dialog class="operation-dialog" id="delete-cluster-dialog" aria-labelledby="delete-cluster-title" aria-describedby="delete-cluster-warning">
        <div class="operation-dialog-shell">
            <header><div><span class="dialog-kicker danger">@T["Cluster.Danger"]</span><h2 id="delete-cluster-title">@T["Cluster.DeleteConfirmTitle"]</h2><p>@T["Cluster.DeleteConfirmIntro"]</p></div><button class="dialog-close" type="button" data-close-delete-cluster aria-label="@T["Cluster.Cancel"]"><i class="fa fa-times" aria-hidden="true"></i></button></header>
            <div class="operation-dialog-body">
                <div class="danger-callout" id="delete-cluster-warning" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i><p>@T["Cluster.DeleteConfirmWarning"]</p></div>
                <ul class="delete-scope-list">
                    <li>@T["Cluster.DeleteScopeProfile"]</li>
                    <li>@T["Cluster.DeleteScopeOperations"]</li>
                    <li>@T["Cluster.DeleteScopeMonitoring"]</li>
                    <li>@T["Cluster.DeleteScopeBackups"]</li>
                    <li>@T["Cluster.DeleteScopeRestores"]</li>
                </ul>
                <p class="delete-preserve-note"><strong>@T["Cluster.DeletePreservedTitle"]</strong> @T["Cluster.DeletePreserved"]</p>
            </div>
            <footer><button class="btn btn-secondary" type="button" data-close-delete-cluster>@T["Cluster.Cancel"]</button><button class="btn btn-danger" type="button" data-confirm-delete-cluster>@T["Cluster.Delete"]</button></footer>
        </div>
    </dialog>
}
@section Scripts { <script src="~/js/clusters.js" asp-append-version="true" defer></script><script src="~/js/cluster-delete-confirm.js" asp-append-version="true" defer></script> }
@functions {
    static string FormatBytes(long bytes) => bytes switch { >= 1_099_511_627_776 => $"{bytes / 1_099_511_627_776d:N1} TiB", >= 1_073_741_824 => $"{bytes / 1_073_741_824d:N1} GiB", >= 1_048_576 => $"{bytes / 1_048_576d:N1} MiB", >= 1_024 => $"{bytes / 1_024d:N1} KiB", _ => $"{bytes:N0} B" };
}
