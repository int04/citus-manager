@model ClusterDetailsViewModel
@{ ViewData["Title"] = Model.Cluster.Name; var inventory = Model.Inventory; }
<div class="page-heading">
    <div><p class="eyebrow">@Model.Cluster.Host:@Model.Cluster.Port / @Model.Cluster.Database</p><h1>@Model.Cluster.Name</h1><p>Citus @Model.Cluster.CitusVersion · TLS @Model.Cluster.SslMode</p></div>
    <div class="heading-actions"><a class="btn btn-secondary" asp-controller="Activity" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id">Activity</a><a class="btn btn-secondary" asp-controller="Metrics" asp-action="Index" asp-route-clusterId="@Model.Cluster.Id">Metrics</a><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Cluster.Id">Refresh inventory</a></div>
</div>
@if (Model.SafeError is not null) { <div class="notice danger" role="alert">@Model.SafeError</div> }
@if (inventory is not null)
{
    <section class="metric-grid" aria-label="Cluster metrics">
        <article class="metric-card"><span>Nodes</span><strong>@inventory.Nodes.Count</strong><small>@inventory.Nodes.Count(x => x.IsActive) active</small></article>
        <article class="metric-card"><span>Workers</span><strong>@inventory.Nodes.Count(x => x.ShouldHaveShards)</strong><small>eligible for shards</small></article>
        <article class="metric-card"><span>Placements</span><strong>@inventory.Nodes.Sum(x => x.PlacementCount)</strong><small>physical shard copies</small></article>
        <article class="metric-card"><span>Distributed tables</span><strong>@inventory.Tables.Count</strong><small>visible in citus_tables</small></article>
    </section>
    <section class="section-block">
        <div class="section-title"><div><h2>Topology</h2><p>Metadata/query nodes + shard-eligible workers.</p></div></div>
        <div class="topology-grid">
        @foreach (var node in inventory.Nodes)
        {
            <article class="node-card">
                <div class="node-card-head"><span class="status-dot @(node.IsActive ? "ok" : "bad")"></span><strong>@node.Host:@node.Port</strong></div>
                <code>@node.Role · group @node.GroupId</code>
                <dl class="compact-dl"><div><dt>Node ID</dt><dd>@node.NodeId</dd></div><div><dt>Placements</dt><dd>@node.PlacementCount</dd></div><div><dt>Shard bytes</dt><dd>@FormatBytes(node.ShardBytes)</dd></div><div><dt>Metadata</dt><dd>@(node.HasMetadata ? (node.MetadataSynced ? "synced" : "unsynced") : "worker")</dd></div></dl>
            </article>
        }
        </div>
    </section>
    <section class="section-block">
        <div class="section-title"><div><h2>Tables</h2><p>Version-dependent columns projected safely.</p></div></div>
        <div class="table-wrap"><table><thead><tr><th>Table</th><th>Type</th><th>Distribution</th><th>Shards</th><th>Colocation</th><th>Size</th><th>Storage</th></tr></thead><tbody>
        @foreach (var table in inventory.Tables)
        { <tr><td><code>@table.Name</code></td><td>@table.Type</td><td><code>@table.DistributionColumn</code></td><td>@table.ShardCount</td><td>@table.ColocationId</td><td>@table.TableSize</td><td>@table.AccessMethod</td></tr> }
        </tbody></table></div>
    </section>
}
@if (User.IsInRole("Operator") || User.IsInRole("Admin"))
{
    <section class="section-block">
        <div class="section-title"><div><h2>Tạo operation plan</h2><p>Không chạy ngay. Admin khác phải duyệt; runner kiểm tra lại capability/state.</p></div></div>
        <form asp-controller="Operations" asp-action="Create" method="post" class="panel form-panel">
            <input type="hidden" name="clusterId" value="@Model.Cluster.Id" />
            <fieldset><legend>Topology operation</legend><div class="form-grid">
                <div class="field"><label for="kind">Operation *</label><select id="kind" name="Kind"><option value="AddWorker">Add worker</option><option value="Rebalance">Rebalance</option><option value="DrainWorker">Drain worker</option><option value="RemoveWorker">Remove worker</option></select></div>
                <div class="field"><label for="workerHost">Worker host</label><input id="workerHost" name="WorkerHost" autocomplete="off" /></div>
                <div class="field"><label for="workerPort">Worker port</label><input id="workerPort" name="WorkerPort" type="number" min="1" max="65535" value="5432" inputmode="numeric" /></div>
                <div class="field"><label for="typedConfirmation">Typed confirmation</label><input id="typedConfirmation" name="TypedConfirmation" autocomplete="off" /><small>Remove: phải khớp chính xác worker host.</small></div>
            </div>
            <label class="check-field"><input type="checkbox" name="ExternalCapacityAndBackupChecksAcknowledged" value="true" /><span>Tôi xác nhận backup/PITR đã test; disk/WAL/network/connection đủ; có rollback owner.</span></label></fieldset>
            <div class="warning-callout"><strong>Cảnh báo:</strong> rebalance/drain di chuyển dữ liệu; không phải backup. Remove chỉ mở khi target có đúng 0 placements.</div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Tạo plan để duyệt</button></div>
        </form>
    </section>
}
<section class="section-block">
    <div class="section-title"><div><h2>Operations</h2><p>Tự cập nhật mỗi 5 giây khi HTMX khả dụng.</p></div></div>
    <div id="operation-table-live" hx-get="@Url.Action("OperationTable", "Clusters", new { id = Model.Cluster.Id })" hx-trigger="every 5s" hx-swap="innerHTML"><partial name="_OperationTable" model="Model.Operations" /></div>
</section>
@if (User.IsInRole("Admin"))
{
    <section class="danger-zone"><h2>Danger zone</h2><p>Xóa profile chỉ xóa control-plane metadata. Không gọi <code>citus_remove_node</code>.</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Cluster.Id" /><button class="btn btn-danger" type="submit">Xóa profile local</button></form></section>
}
@functions {
    static string FormatBytes(long bytes) => bytes switch { >= 1_099_511_627_776 => $"{bytes / 1_099_511_627_776d:N1} TiB", >= 1_073_741_824 => $"{bytes / 1_073_741_824d:N1} GiB", >= 1_048_576 => $"{bytes / 1_048_576d:N1} MiB", _ => $"{bytes:N0} B" };
}
