@model SetupViewModel
@using CitusManager.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountResource> T
@{ ViewData["Title"] = T["Setup.Title"]; }

<section class="setup-page" aria-label="Citus Manager setup">
    <header class="setup-page-brand" aria-label="Citus Manager">
        <span aria-hidden="true">CM</span>
        <strong>Citus Manager</strong>
    </header>

    <div class="setup-page-content">
        <form asp-action="Setup" method="post" class="setup-form setup-form-first">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="setup-fields">
                <div class="field">
                    <label asp-for="DisplayName">@T["Field.DisplayName"]</label>
                    <input asp-for="DisplayName" autocomplete="name" placeholder="@T["Setup.DisplayNamePlaceholder"]" autofocus />
                    <span asp-validation-for="DisplayName" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="Email">@T["Field.LoginEmail"]</label>
                    <input asp-for="Email" autocomplete="email" inputmode="email" placeholder="admin@company.com" />
                    <span asp-validation-for="Email" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="Password">@T["Field.Password"]</label>
                    <div class="password-field">
                        <input asp-for="Password" autocomplete="new-password" />
                        <button type="button" data-password-toggle="Password" aria-controls="Password" aria-label="@T["Password.Show"]">@T["Password.ShowShort"]</button>
                    </div>
                    <span asp-validation-for="Password" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">@T["Field.ConfirmPassword"]</label>
                    <div class="password-field">
                        <input asp-for="ConfirmPassword" autocomplete="new-password" />
                        <button type="button" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="@T["Password.ShowConfirmation"]">@T["Password.ShowShort"]</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" aria-live="polite"></span>
                </div>
            </div>

            <div class="setup-page-actions">
                <button class="btn btn-primary" type="submit">@T["Setup.Submit"]</button>
            </div>
        </form>
    </div>
</section>

@section Styles {
    <style>
        .auth-shell:has(.setup-page) { background: #f1f5f9; padding: 1.5rem; }
        .auth-shell:has(.setup-page)::before,
        .auth-shell:has(.setup-page)::after { display: none; }
        .setup-page { --setup-surface: #fff; --setup-input: #fff; --setup-border: #d8e1ea; --setup-text: #172033; --setup-muted: #64748b; --setup-accent: #4f46e5; background: var(--setup-surface); border: 1px solid var(--setup-border); border-radius: .75rem; color: var(--setup-text); max-width: 34rem; overflow: hidden; position: relative; width: 100%; }
        .setup-page-brand { align-items: center; border-bottom: 1px solid var(--setup-border); display: flex; font-size: .875rem; gap: .65rem; padding: 1rem 1.25rem; }
        .setup-page-brand > span { align-items: center; border: 1px solid var(--setup-border); border-radius: .3rem; color: var(--setup-text); display: inline-flex; font-family: var(--font-mono); font-size: .68rem; font-weight: 700; height: 1.75rem; justify-content: center; letter-spacing: .04em; width: 1.75rem; }
        .setup-page-content { padding: 1.5rem 1.25rem; }
        .setup-form { margin-top: 1.5rem; }
        .setup-form-first { margin-top: 0; }
        .setup-fields { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .setup-form .field { margin: 0; }
        .setup-form .field label { color: var(--setup-text); }
        .setup-form .field input { background: var(--setup-input); border-color: var(--setup-border); border-radius: .45rem; color: var(--setup-text); }
        .setup-form .field input:focus { border-color: var(--setup-accent); }
        .password-field { position: relative; }
        .password-field input { padding-right: 4.5rem !important; }
        .password-field button { color: var(--setup-muted); font-size: .75rem; font-weight: 600; min-height: 2.5rem; padding: 0 .7rem; position: absolute; right: 0; top: 0; }
        .password-field button:hover { color: var(--setup-text); }
        .setup-page-actions { border-top: 1px solid var(--setup-border); display: flex; justify-content: flex-end; margin-top: 1.5rem; padding-top: 1.25rem; }
        .setup-page-actions .btn { border-radius: .45rem; box-shadow: none; flex: none; }
        [data-theme="dark"] .auth-shell:has(.setup-page) { background: #111827; }
        [data-theme="dark"] .setup-page { --setup-surface: #161d27; --setup-input: #0f1520; --setup-border: rgba(255, 255, 255, .14); --setup-text: #f1f5f9; --setup-muted: #94a3b8; --setup-accent: #818cf8; }
        @@media (max-width: 639px) { .auth-shell:has(.setup-page) { align-items: start; padding-top: 5rem; } .setup-page-content { padding: 1.25rem; } .setup-fields { grid-template-columns: 1fr; } .setup-page-actions .btn { width: 100%; } }
    </style>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
