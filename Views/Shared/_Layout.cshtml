            .dg-fk-mapping-item.is-active { @@apply bg-[#3788df] text-white; }
            .dg-fk-column-properties { @@apply grid content-start gap-3 p-4; }
            .dg-fk-column-properties label, .dg-fk-action-properties > label { display: grid; grid-template-columns: 8rem minmax(0,1fr); align-items: center; gap: .75rem; color: #e3e8eb; font-size: 11px; }
            .dg-fk-column-properties select, .dg-fk-action-properties select { @@apply min-h-9 min-w-0 rounded-[3px] border border-[#4a535b] bg-[#22282d] px-3 text-[11px] text-[#edf1f3] focus:border-[#55b9ee] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-45; }
            .dg-fk-action-properties { @@apply grid gap-3 border-t border-[#3d4248] p-4; }
            .dg-fk-toggle-row { @@apply ml-[8.75rem] flex flex-wrap items-center gap-8; }
            .dg-fk-toggle-row label { @@apply flex items-center gap-2 text-[11px] text-[#edf1f3]; }
            .dg-fk-toggle-row input { @@apply size-4 accent-[#ff786f] disabled:cursor-not-allowed disabled:opacity-40; }
            .dg-fk-mapping-row { display: grid; grid-template-columns: 24px minmax(8rem,1fr) 24px minmax(8rem,1fr) 32px; align-items: center; gap: .5rem; padding: .25rem; }
            .dg-fk-mapping-row > span:first-child { @@apply text-center text-[9px] text-[#748089]; }
            .dg-fk-mapping-row select, .dg-fk-mapping-row input { @@apply min-h-8 min-w-0 rounded-[2px] border border-[#4a5158] bg-[#20252a] px-2 text-[10px] text-[#e5e9eb] focus:border-[#4a9ff5] focus-visible:outline-none; }
            .dg-mapping-arrow { @@apply text-center text-[#6e7a83]; }
            .dg-fk-mapping-row button { @@apply grid size-7 place-items-center rounded-[3px] text-base text-[#df706d] hover:bg-[#513536] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#ef6b68]; }
            .dg-distribution-panel { @@apply grid grid-cols-3 gap-3 border-t border-[#3d4248] bg-[#22272c] p-3; }
            .dg-preview-splitter { grid-column: 1 / -1; grid-row: 2; position: relative; cursor: row-resize; touch-action: none; background: #2b3035; border-top: 1px solid #3d4248; border-bottom: 1px solid #171b1f; }
            .dg-preview-splitter::before { content: ""; position: absolute; inset: -4px 0; }
