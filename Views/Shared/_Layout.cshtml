            .dg-preview-splitter:hover, .dg-preview-splitter.is-dragging { background: #31536c; }
            .dg-preview-splitter:focus-visible { outline: 1px solid #55b9ee; outline-offset: -1px; }
            .dg-sql-preview { grid-column: 1 / -1; grid-row: 3; @@apply min-h-0 bg-[#20252a]; }
            .dg-sql-preview header { @@apply flex min-h-9 items-center gap-2 border-b border-[#343a40] px-3 text-[11px] text-[#d8dde1]; }
            .dg-sql-preview header small { @@apply ml-auto text-[9px] text-[#6f7880]; }
            .dg-preview-caret { @@apply text-[#aeb6bd]; }
            .dg-sql-preview pre { @@apply m-0 overflow-auto px-4 py-3 font-mono text-sm font-normal leading-6 text-[#d7dce0]; height: calc(100% - 36px); }
            .dg-sql-preview code { padding: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; white-space: pre; }
            .database-inspection-list { @@apply grid gap-1 rounded-sm border border-[#bec8ce] bg-white p-3 dark:border-white/10 dark:bg-white/[.025]; }
            .database-inspection-list > div { @@apply grid grid-cols-[10rem_minmax(0,1fr)] gap-3 border-b border-[#d9e0e4] py-2 text-xs last:border-0 dark:border-white/[.06]; }
            .database-inspection-list dt { @@apply font-semibold text-[#526a78] dark:text-slate-400; }
            .database-inspection-list dd { @@apply break-all font-mono text-[#273f4e] dark:text-slate-200; }
            .database-modal-open { overflow: hidden; }
            @@media (prefers-reduced-motion: reduce) { .database-context-submenu { transition: none; } }
            @@media (pointer: coarse) { .database-context-item { min-height: 44px; } }
            @@media (max-width: 760px) {
                .database-action-card { width: calc(100vw - 12px); max-height: calc(100dvh - 12px); }
                .database-action-card.is-table-designer { width: calc(100vw - 8px); height: calc(100dvh - 8px); }
                .dg-table-designer { grid-template-columns: minmax(0,1fr); grid-template-rows: auto minmax(180px,1fr) 7px var(--dg-preview-height,180px); }
                .dg-designer-sidebar { @@apply border-b border-r-0 border-[#3d4248]; }
                .dg-designer-toolbar { display: none; }
                .dg-designer-object { @@apply mx-2 mb-0 mt-2; }
                .dg-designer-tree { @@apply m-0 flex gap-1 overflow-x-auto p-2; }
                .dg-designer-tree button { @@apply shrink-0; }
                .dg-designer-tree-group { @@apply shrink-0; }
                .dg-designer-tree-children { display: none; }
                .dg-key-mobile-select { @@apply block min-h-8 min-w-32 rounded-[2px] border border-[#4a5158] bg-[#20252a] px-2 text-[10px] text-[#e5e9eb]; }
                .dg-designer-main { grid-column: 1; grid-row: 2; }
                .dg-preview-splitter { grid-column: 1; grid-row: 3; }
                .dg-sql-preview { grid-column: 1; grid-row: 4; }
                .dg-object-identity, .dg-distribution-panel, .dg-table-citus-options > div { @@apply grid-cols-1; }
                .dg-table-root-properties > label { grid-template-columns: minmax(0,1fr); gap: .35rem; }
                .dg-inline-property, .dg-table-grant-row { grid-template-columns: minmax(0,1fr); }
                .dg-key-grid, .dg-index-grid, .dg-fk-grid, .dg-check-grid { grid-template-columns: minmax(0,1fr); }
                .dg-key-properties, .dg-key-columns-workspace, .dg-property-grid, .dg-fk-properties { grid-template-columns: minmax(0,1fr); }
                .dg-index-property-row, .dg-index-column-properties label, .dg-index-advanced-properties label { grid-template-columns: minmax(0,1fr); gap: .35rem; }
                .dg-index-toggle-row { @@apply ml-0; }
                .dg-index-columns-workspace { grid-template-columns: minmax(0,1fr); }
                .dg-fk-property-row, .dg-fk-column-properties label, .dg-fk-action-properties > label { grid-template-columns: minmax(0,1fr); gap: .35rem; }
                .dg-fk-columns-workspace { grid-template-columns: minmax(0,1fr); }
                .dg-fk-toggle-row { @@apply ml-0; }
                .dg-column-property-form { @@apply px-3 py-4; }
                .dg-column-property-row, .dg-column-toggle-row { grid-template-columns: minmax(0,1fr); gap: .35rem; }
                .dg-column-toggle-row > span { display: none; }
                .dg-identity-options { grid-template-columns: minmax(0,1fr); margin-left: 0; }
                .dg-identity-options > label:nth-child(4) { grid-column: auto; }
                .dg-column-form-note { margin-left: 0; }
                .dg-wide-property { grid-column: auto; }
                .dg-key-column-list { @@apply border-b border-r-0 border-[#3d444a]; }
            }
            body:has(> .database-tool-shell) { @@apply overflow-hidden; }
            .database-tool-shell { @@apply h-dvh min-h-0 overflow-hidden bg-[#f6f6f6] dark:bg-[#11161c]; }
            .database-tool-shell .database-page { @@apply flex h-full min-h-0 flex-col overflow-hidden; }
            .database-tool-shell .pma-topbar,
            .database-tool-shell .pma-main-tabs { @@apply relative top-auto shrink-0; }
            .database-tool-shell .database-workbench { @@apply min-h-0 flex-1; }
            .database-tool-shell .database-tree { @@apply lg:relative lg:top-auto lg:h-full lg:min-h-0; }
            .database-tool-shell .database-tree-scroll { @@apply min-h-0 max-h-none; }
            .database-tool-shell .pma-content { @@apply h-full min-h-0 overflow-hidden; }
            .database-tool-shell .pma-context-bar { @@apply top-0; }
            @@media (max-width: 1023px) {
                .pma-topbar { @@apply top-0 grid-cols-[minmax(0,1fr)_auto]; }
                .pma-server-summary { @@apply col-span-2 row-start-2; }
                .pma-server-path { @@apply min-w-0 flex-1 border-t border-[#bbc5cb] py-1.5 dark:border-white/10; }
                .database-workbench { @@apply grid-cols-1; }
                .pma-navigation-toggle, .pma-navigation-close { @@apply inline-flex; }
                .pma-navigation-close { @@apply size-9 shrink-0 items-center justify-center rounded-sm text-[#4d6777] hover:bg-black/5 dark:text-slate-300 dark:hover:bg-white/[.06]; }
                .pma-navigation-close svg { @@apply size-4; }
                .database-tree { @@apply fixed inset-y-0 left-0 z-50 h-dvh w-[17.5rem] -translate-x-full border-r transition-transform duration-200; }
                .database-tree.is-open { @@apply translate-x-0; }
                .database-tree-scroll { @@apply max-h-none; }
                .pma-navigation-scrim:not(.hidden) { @@apply fixed inset-0 z-40 block bg-slate-950/45 backdrop-blur-[1px]; }
                .pma-context-bar { @@apply static; }
            }
            @@media (max-width: 639px) {
                .pma-topbar { @@apply gap-2 px-2; }
                .pma-product-mark { @@apply border-r-0 pr-0; }
                .pma-product-mark small, .pma-icon-action span, .pma-server-path .pma-path-item:first-child, .pma-server-path .pma-path-separator:first-of-type { @@apply hidden; }
                .pma-icon-action { @@apply size-10 justify-center p-0; }
                .pma-icon-action svg { @@apply size-4; }
                .pma-main-tabs { @@apply top-auto overflow-x-auto px-0; }
                .pma-main-tabs button { @@apply min-h-11 shrink-0 px-3; }
                .database-tree-scroll { @@apply max-h-none; }
                .pma-context-bar { @@apply items-start; }
                .pma-page-size { @@apply ml-auto min-h-11; }
                .database-result, .sql-console { @@apply p-2; }
            }
            .empty-state { @@apply rounded-xl border border-dashed border-slate-300 bg-white/50 p-10 text-center text-sm text-slate-500 dark:border-white/15 dark:bg-white/[.02] dark:text-slate-400; }
            .empty-state h3 { @@apply mb-1; }
            .empty-state.compact { @@apply p-5; }
            .danger-zone { @@apply mt-8 rounded-xl border border-rose-200 bg-rose-50/60 p-5 dark:border-rose-500/20 dark:bg-rose-500/[.06]; }
            .danger-zone p { @@apply mt-1 text-xs text-rose-700 dark:text-rose-300; }
            .two-column { @@apply grid grid-cols-1 gap-4 xl:grid-cols-[minmax(18rem,.8fr)_minmax(0,1.2fr)]; }
            .json-block { @@apply mt-3 max-h-[30rem] overflow-auto whitespace-pre-wrap break-all rounded-lg border border-slate-200 bg-slate-950 p-4 text-[11px] leading-5 text-slate-300 dark:border-white/10 dark:bg-black/30; }
            .timeline { @@apply m-0 list-none p-0; }
            .timeline li { @@apply flex gap-3 border-b border-slate-100 py-4 last:border-0 dark:border-white/[.07]; }
            .timeline p { @@apply my-1 text-xs text-slate-500 dark:text-slate-400; }
            .timeline small { @@apply text-[10px] text-slate-400 dark:text-slate-500; }
