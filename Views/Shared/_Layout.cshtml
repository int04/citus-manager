            .dg-wide-property { grid-column: 1 / -1; }
            .dg-option-group { @@apply flex min-h-16 flex-wrap items-center gap-4 rounded-[3px] border border-[#454d54] bg-[#22272c] px-3 py-2; }
            .dg-option-group legend { @@apply px-1 text-[9px] font-medium text-[#8f99a1]; }
            .dg-option-group label { @@apply flex items-center gap-2 text-[10px] text-[#d3d8dc]; }
            .dg-option-group input { @@apply size-3.5 accent-sky-500; }
            .dg-auto-name-toggle { @@apply flex items-center gap-1.5 text-[9px] font-normal text-[#8d989f]; }
