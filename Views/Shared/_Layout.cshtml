            .dg-column-property-row input, .dg-column-property-row select, .dg-column-property-row textarea,
            .dg-identity-options input { @@apply min-h-9 min-w-0 w-full rounded-[3px] border border-[#4a535b] bg-[#22282d] px-3 text-[11px] text-[#edf1f3] shadow-inner focus:border-[#55b9ee] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-45; }
            .dg-column-property-row textarea { @@apply resize-y py-2; }
