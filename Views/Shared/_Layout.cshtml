            .dg-fk-columns-workspace .dg-fk-mapping-list { @@apply border-0 border-r border-[#3d444a]; }
            .dg-fk-mapping-item { @@apply block w-full rounded-[2px] px-2 py-1.5 text-left text-[11px] text-[#aeb7be] hover:bg-white/[.05] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-[#4a9ff5]; }
