@model ErrorViewModel
@{ ViewData["Title"] = "Lỗi hệ thống"; }
<section class="mx-auto max-w-2xl rounded-2xl border border-rose-200 bg-white p-8 shadow-sm dark:border-rose-500/20 dark:bg-white/[.035] dark:shadow-none">
    <div class="mb-5 grid size-12 place-items-center rounded-xl bg-rose-100 text-rose-600 dark:bg-rose-500/10 dark:text-rose-300">
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg>
    </div>
    <p class="eyebrow">REQUEST FAILED</p><h1>Không thể xử lý yêu cầu</h1>
    <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">Kiểm tra trạng thái control database và thử lại. Chi tiết nội bộ không được hiển thị để tránh lộ dữ liệu nhạy cảm.</p>
    @if (Model.ShowRequestId) { <div class="callout mt-5"><strong>Trace ID:</strong> <code>@Model.RequestId</code></div> }
    <div class="form-actions"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về dashboard</a></div>
</section>
