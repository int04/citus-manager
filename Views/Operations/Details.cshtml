@model OperationResponse
@{ ViewData["Title"] = $"Operation {Model.Id.ToString()[..8]}"; }
<div class="page-heading"><div><p class="eyebrow">@Model.Risk · @Model.RequestedAt.ToLocalTime().ToString("g")</p><h1>@Model.Kind</h1><p><code>@Model.Id</code></p></div><span class="status-pill status-large @StatusClass(Model.Status)">@Model.Status</span></div>
@if (Model.SafeError is not null) { <div class="notice danger" role="alert">@Model.SafeError</div> }
<div class="two-column">
    <section class="panel"><h2>Approval</h2><dl class="detail-list"><div><dt>Requested by</dt><dd><code>@Model.RequestedBy</code></dd></div><div><dt>Approved by</dt><dd><code>@(Model.ApprovedBy?.ToString() ?? "pending")</code></dd></div><div><dt>Started</dt><dd>@(Model.StartedAt?.ToLocalTime().ToString("G") ?? "—")</dd></div><div><dt>Completed</dt><dd>@(Model.CompletedAt?.ToLocalTime().ToString("G") ?? "—")</dd></div></dl>
    <div class="form-actions">
        @if (Model.Status == OperationStatus.AwaitingApproval && User.IsInRole("Admin")) { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary" type="submit">Approve & queue</button></form> }
        @if (Model.Status is OperationStatus.AwaitingApproval or OperationStatus.Approved or OperationStatus.Running) { <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-danger" type="submit">Yêu cầu hủy</button></form> }
    </div></section>
    <section class="panel"><h2>Immutable plan</h2><pre class="json-block">@Pretty(Model.PlanJson)</pre></section>
</div>
<section class="section-block"><div class="section-title"><div><h2>Checkpoints</h2><p>Runner persist từng bước; restart tiếp tục từ state an toàn.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Refresh</a></div>
@if (Model.Steps.Count == 0) { <div class="empty-state compact"><p>Chưa chạy.</p></div> } else { <ol class="timeline">@foreach (var step in Model.Steps) { <li><span class="status-dot @(step.Status == "Succeeded" ? "ok" : "bad")"></span><div><strong>@step.Sequence. @step.Name</strong><p>@step.Detail</p><small>@step.CompletedAt?.ToLocalTime().ToString("G")</small></div></li> }</ol> }
</section>
@if (Model.ResultJson is not null) { <section class="panel"><h2>Sanitized result</h2><pre class="json-block">@Pretty(Model.ResultJson)</pre></section> }
@functions {
    static string StatusClass(OperationStatus status) => status switch { OperationStatus.Succeeded => "success", OperationStatus.Failed or OperationStatus.RecoveryRequired => "danger", OperationStatus.Running or OperationStatus.Approved => "warning", _ => "neutral" };
    static string Pretty(string json) { try { using var doc = System.Text.Json.JsonDocument.Parse(json); return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); } catch { return "Invalid sanitized JSON"; } }
}
